<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not a new dependency: it already resolves transitively at this exact version, so the graph
         is unchanged. Referenced explicitly because Composition names IServiceCollection directly,
         which is what lets a handler registration see the internal module the handlers share, and a
         type used directly should not depend on another package continuing to drag it in. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.11.0.117924">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Drawn: commands -> Source repository (ADR-0014). -->
    <ProjectReference Include="..\MEditService.SourceRepo\MEditService.SourceRepo.csproj" />
    <!-- Drawn: commands -> Plugin adapter (ADR-0014). -->
    <ProjectReference Include="..\MEditService.PluginAdapter\MEditService.PluginAdapter.csproj" />
    <!-- The kernel, by the band's rule (ADR-0014): every Core box and driven adapter reads all three. -->
    <ProjectReference Include="..\MEditService.LoadOrder\MEditService.LoadOrder.csproj" />
    <!-- The kernel, by the band's rule (ADR-0014): every Core box and driven adapter reads all three. -->
    <ProjectReference Include="..\MEditService.Codec\MEditService.Codec.csproj" />
    <!-- The kernel, by the band's rule (ADR-0014): every Core box and driven adapter reads all three. -->
    <ProjectReference Include="..\MEditService.Ports\MEditService.Ports.csproj" />
  </ItemGroup>

</Project>
