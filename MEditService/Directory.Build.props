<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Complexity / maintainability rules (S3776 S1541 S138 S134 S107 S1067) are held at `suggestion`
      severity in .editorconfig, so they are info-level and never warnings — no TreatWarningsAsErrors
      exemption is needed. The code-quality Stop hook (.claude/hooks/code-quality.py) surfaces them,
      scoped to changed files, for per-instance triage. See /validate Step 3.
    -->
  </PropertyGroup>

  <!-- ADR-0032 rule 2, held by the build for every project. The symbol list is the one at the
       solution root; RS0030's per-folder severity is in .editorconfig. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.globalconfig" />
  </ItemGroup>
</Project>
