<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Complexity / maintainability rules (S3776 S1541 S138 S134 S107 S1067) are held at `suggestion`
      severity in .editorconfig, so they are info-level and never warnings — no TreatWarningsAsErrors
      exemption is needed. The code-quality Stop hook (.claude/hooks/code-quality.py) surfaces them,
      scoped to changed files, for per-instance triage.
    -->
    <!-- A box's references are its project file's (ADR-0014; target-architecture.md § The rule is
         the reference list), so a box two hops down is a compile error rather than a line nobody
         noticed arriving. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <MutagenVersion>0.55.0-modbench.1</MutagenVersion>
  </PropertyGroup>

  <!-- ADR-0005: the codec's projects and PluginAdapter are the boxes that hold live Mutagen objects, so
       they carry no ban; everything else that must never hold one is these seven production boxes.
       No test project and not TestSupport — fixtures assemble plugins from live objects by design. -->
  <PropertyGroup>
    <MutagenBanIncluded Condition="'$(MSBuildProjectName)' == 'MEditService.Http'">true</MutagenBanIncluded>
    <MutagenBanIncluded Condition="'$(MSBuildProjectName)' == 'MEditService.Commands'">true</MutagenBanIncluded>
    <MutagenBanIncluded Condition="'$(MSBuildProjectName)' == 'MEditService.LoadOrder'">true</MutagenBanIncluded>
    <MutagenBanIncluded Condition="'$(MSBuildProjectName)' == 'MEditService.Ports'">true</MutagenBanIncluded>
    <MutagenBanIncluded Condition="'$(MSBuildProjectName)' == 'MEditService.Index'">true</MutagenBanIncluded>
    <MutagenBanIncluded Condition="'$(MSBuildProjectName)' == 'MEditService.SourceAdapter'">true</MutagenBanIncluded>
    <!-- Every production box, by the same naming rule the architecture gates read the solution
         with: a test project ends in .Tests, and TestSupport is the shared fixture library. -->
    <SyncOverAsyncBanIncluded Condition="!$(MSBuildProjectName.EndsWith('.Tests')) And '$(MSBuildProjectName)' != 'MEditService.TestSupport'">true</SyncOverAsyncBanIncluded>
  </PropertyGroup>

  <!-- RS0030 is at error for every project (.editorconfig); no folder carries its own severity.
       BannedSymbols.txt (time, blocking waits) binds unconditionally. BannedSymbols.Mutagen.txt
       (the live-object namespaces) binds only the projects named above.
       BannedSymbols.SyncOverAsync.txt binds every production box and no test project. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.globalconfig" />
    <!-- Identity is not a model of a record (ADR-0005): FormKey, ModKey and GameRelease are
         values every box names, and the ban above is what keeps the live-object namespaces out.
         Pinned to the version the codec's game projects resolve. -->
    <PackageReference Include="Mutagen.Bethesda.Core" Version="$(MutagenVersion)" />
    <!-- No built-in analyzer reads the null-forgiving operator; NX0001 does, held at error through
         .editorconfig for every project, production and test alike. -->
    <PackageReference Include="Nullable.Extended.Analyzer" Version="1.16.6891">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(MutagenBanIncluded)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Mutagen.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(SyncOverAsyncBanIncluded)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.SyncOverAsync.txt" />
  </ItemGroup>
</Project>
