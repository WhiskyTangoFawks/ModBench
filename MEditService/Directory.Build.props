<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Complexity / maintainability rules (S3776 S1541 S138 S134 S107 S1067) are held at `suggestion`
      severity in .editorconfig, so they are info-level and never warnings — no TreatWarningsAsErrors
      exemption is needed. The code-quality Stop hook (.claude/hooks/code-quality.py) surfaces them,
      scoped to changed files, for per-instance triage. See /validate Step 3.
    -->
    <!-- One project per box (ADR-0014): a box reaches only the boxes its own reference list draws
         in docs/architecture/target-architecture-references.d2, so a box two hops down is a compile
         error rather than a line nobody noticed arriving. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <!-- ADR-0005 rule 2: the six boxes a live Mutagen object legitimately reaches. -->
  <PropertyGroup>
    <MutagenBanExempt Condition="'$(MSBuildProjectName)' == 'MEditService.Codec'">true</MutagenBanExempt>
    <MutagenBanExempt Condition="'$(MSBuildProjectName)' == 'MEditService.PluginAdapter'">true</MutagenBanExempt>
    <MutagenBanExempt Condition="'$(MSBuildProjectName)' == 'MEditService.Codec.Tests'">true</MutagenBanExempt>
    <MutagenBanExempt Condition="'$(MSBuildProjectName)' == 'MEditService.PluginAdapter.Tests'">true</MutagenBanExempt>
    <MutagenBanExempt Condition="'$(MSBuildProjectName)' == 'MEditService.TestSupport'">true</MutagenBanExempt>
    <MutagenBanExempt Condition="'$(MSBuildProjectName)' == 'MEditService.CrossBox.Tests'">true</MutagenBanExempt>
  </PropertyGroup>

  <!-- RS0030 is at error for every project (.editorconfig); no folder carries its own severity.
       BannedSymbols.txt (time, blocking waits) binds unconditionally. BannedSymbols.Mutagen.txt
       (the live-object namespaces) excludes the six projects above by name, not by folder. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.globalconfig" />
    <!-- Identity is not a model of a record (ADR-0005 rule 2): FormKey, ModKey and GameRelease are
         values every box names, and the ban above is what keeps the live-object namespaces out.
         Pinned to the version Mutagen.Bethesda.Fallout4 resolves in the codec and the adapter. -->
    <PackageReference Include="Mutagen.Bethesda.Core" Version="0.53.1" />
    <!-- No built-in analyzer reads the null-forgiving operator; NX0001 does, held at error through
         .editorconfig for every project, production and test alike. -->
    <PackageReference Include="Nullable.Extended.Analyzer" Version="1.16.6891">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(MutagenBanExempt)' != 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Mutagen.txt" />
  </ItemGroup>
</Project>
