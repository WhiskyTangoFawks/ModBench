<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MEditService.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- #367: Mutagen.Bethesda.Serialization.SourceGenerator 1.37.x requires Roslyn >= 4.14; this
         repo's SDK (9.0.119) ships Roslyn 4.12, so the generator fails to load (CS9057) without
         this pin. Remove once the repo's own SDK floor moves past 4.14: Microsoft.Net.Compilers.
         Toolset becomes redundant then, not wrong; there's no forcing function to delete it. -->
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Autofac" Version="9.1.0" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.2" />
    <!-- Pinned to 0.53.x: 0.54.0 reintroduces a binary round-trip defect confined to the lazy
         binary-overlay reader (Fallout4ModBinaryOverlay / ModFactory.ImportGetter) — an
         alphabetized ObjectTemplate_Registration.AllRecordTypes splits every on-disk
         OBTF/FULL/OBTS template in two on read, and the write serializes the inflated list
         (FO4 weapon ObjectTemplates, spike #359). Confirmed still failing
         BinaryRoundTripGateTests.LazyOverlayReloadAndRewrite_ProducesByteIdenticalOutput
         (MEditService.Tests/RealData) as of this pin. The production save path
         (PluginWriter.SaveAsync, .SaveAsync_ReloadAndResave_ProducesByteIdenticalOutput in the same
         file) goes through ModFactory.ImportSetter's genuine deep parse instead and does NOT reach
         this defect — so a green save-path test is not evidence 0.54.0 is safe; the overlay test is
         the one that gates a bump. GameSession's own read/indexing path uses the same
         ModFactory.ImportGetter overlay this bug lives in, so this isn't a defect confined to an
         unused code path. Move only once #385 confirms the regression is fixed upstream. -->
    <PackageReference Include="Mutagen.Bethesda.Fallout4" Version="0.53.1" />
    <!-- #367: library-level integration of Spriggit's codec (ADR-0040), not the Spriggit tool
         itself: avoids its exe-per-version machinery and its exact Mutagen [0.54.0] pin, which
         this repo cannot take (see the 0.53.1 pin comment above). Serialization 1.37.1 depends on
         Mutagen.Bethesda.Core >= 0.51.3 (a floor, not Spriggit's exact pin), so it is compatible
         with 0.53.1, confirmed via the nuspec; restores with zero NuGet warnings.
         #412: the JSON kernel (ADR-0041, superseding ADR-0040's YAML kernel) is the Newtonsoft
         translation package, not a package literally named ".Json" — confirmed on nuget.org; it
         exists at this exact 1.37.1 version, matching the other two pins here. -->
    <PackageReference Include="Mutagen.Bethesda.Serialization" Version="1.37.1" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.Newtonsoft" Version="1.37.1" />
    <!-- #405: GitCli logs a git failure's full argument vector via Serilog's ambient Log.Logger
         (the same gateway MEditService.Api/Program.cs already sets for the whole process) rather
         than take an ILogger — there is no injected logger reaching this static class, and this is
         a single fire-and-forget diagnostic line at one throw site, not a case for wiring ILogger
         through GitCli and every SourceRepository call site above it. Version pinned to the
         transitive resolution Serilog.AspNetCore already brings into MEditService.Api, so this adds
         no second Serilog version to the solution. -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.SourceGenerator" Version="1.37.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- #413: not a new dependency — Mutagen.Bethesda.Serialization already resolves this exact
         version transitively, and SerializationMetaData takes an IFileSystem from it. Referenced
         explicitly because RecordTextCodec now names those types in production code (it suppresses
         the child-record folder creation a container write would otherwise do), and a type used
         directly should not depend on another package continuing to drag it in. -->
    <PackageReference Include="System.IO.Abstractions" Version="22.0.16" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.11.0.117924">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
