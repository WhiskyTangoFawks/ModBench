{
  "stryker-config": {
    "solution": "MEditService.sln",
    "test-projects": [
      "MEditService.Tests/MEditService.Tests.csproj"
    ],
    "coverage-analysis": "perTest",
    "mutation-level": "Standard",
    "reporters": [
      "json"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/MEditService.Codec/**/*.cs",
      "**/MEditService.Commands/**/*.cs",
      "**/MEditService.Index/**/*.cs",
      "**/MEditService.LoadOrder/**/*.cs",
      "**/MEditService.PluginAdapter/**/*.cs",
      "**/MEditService.Ports/**/*.cs",
      "**/MEditService.Queries/**/*.cs",
      "**/MEditService.SourceRepo/**/*.cs",
      "!**/MEditService.Queries/RecordQueryService.cs",
      "!**/MEditService.Ports/LoadOrderStatus.cs"
    ],
    "ignore-methods": [
      "Log*"
    ],
    "ignore-mutations": [
      "String"
    ],
    "since": {
      "enabled": false,
      "target": "main"
    }
  }
}
