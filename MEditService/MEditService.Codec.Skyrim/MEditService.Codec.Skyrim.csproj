<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Mutagen.Bethesda.Skyrim" />
    <Using Include="Mutagen.Bethesda.Skyrim.SkyrimMod" Alias="GameMod" />
    <Using Include="Mutagen.Bethesda.Skyrim.ISkyrimModGetter" Alias="IGameModGetter" />
    <Using Include="Mutagen.Bethesda.Skyrim.ISkyrimModHeaderGetter" Alias="IGameModHeaderGetter" />
    <Compile Include="../MEditService.Codec/Game/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned with MEditService.Codec's Mutagen and Serialization references; its comments say what
         the versions wait on. -->
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="Mutagen.Bethesda.Serialization" Version="1.37.1" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.Newtonsoft" Version="1.37.1" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.SourceGenerator" Version="1.37.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.11.0.117924">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MEditService.Codec\MEditService.Codec.csproj" />
  </ItemGroup>

</Project>
