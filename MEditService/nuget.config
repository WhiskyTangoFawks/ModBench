<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- modbench-stack is a local feed of the Mutagen fork's modbench-stack build, outside git. Each machine
       declares it once: dotnet nuget add source <feed folder> -n modbench-stack -->
  <packageSourceMapping>
    <packageSource key="modbench-stack">
      <package pattern="Mutagen.Bethesda.Core" />
      <package pattern="Mutagen.Bethesda.Kernel" />
      <package pattern="Mutagen.Bethesda.Fallout4" />
      <package pattern="Mutagen.Bethesda.Skyrim" />
      <package pattern="Mutagen.Bethesda.Starfield" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
