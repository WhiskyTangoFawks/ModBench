<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="mutagen-feed" value="../../mutagen-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="mutagen-feed">
      <package pattern="Mutagen.Bethesda.Core" />
      <package pattern="Mutagen.Bethesda.Kernel" />
      <package pattern="Mutagen.Bethesda.Fallout4" />
      <package pattern="Mutagen.Bethesda.Skyrim" />
      <package pattern="Mutagen.Bethesda.Starfield" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
