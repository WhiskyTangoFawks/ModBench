{
  "stryker-config": {
    "solution": "MEditService.sln",
    "test-projects": [
      "MEditService.Ports.Tests/MEditService.Ports.Tests.csproj"
    ],
    "coverage-analysis": "perTest",
    "mutation-level": "Standard",
    "reporters": [
      "json",
      "html",
      "dots"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/MEditService.Ports/**/*.cs",
      "!**/MEditService.Ports/LoadOrderStatus.cs"
    ],
    "ignore-methods": [
      "Log*"
    ],
    "ignore-mutations": [
      "String"
    ]
  }
}