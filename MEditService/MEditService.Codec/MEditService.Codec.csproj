<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Each game's project compiles these against its own types (MEditService.Codec.<Game>). -->
    <Compile Remove="Game/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serialization stays at 1.37.1 until a release of its source generator emits code for a whole-mod seed. -->
    <!-- Library-level integration of Mutagen.Bethesda.Serialization (ADR-0004), not the Spriggit tool
         itself: avoids its exe-per-version machinery and its exact Mutagen pin. Serialization 1.37.1
         depends on Mutagen.Bethesda.Core >= 0.51.3 (a floor), so it builds against 0.54.4.
         The JSON kernel (ADR-0005) is the Newtonsoft translation package, not a package literally
         named ".Json" — confirmed on nuget.org; it exists at this exact 1.37.1 version, matching the
         other pin here. -->
    <PackageReference Include="Mutagen.Bethesda.Serialization" Version="1.37.1" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.Newtonsoft" Version="1.37.1" />
    <!-- Not a new dependency — Mutagen.Bethesda.Serialization already resolves this exact
         version transitively, and SerializationMetaData takes an IFileSystem from it. Referenced
         explicitly because RecordTextCodec names those types in production code (it suppresses
         the child-record folder creation a container write would otherwise do), and a type used
         directly should not depend on another package continuing to drag it in. -->
    <PackageReference Include="System.IO.Abstractions" Version="22.1.1" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.11.0.117924">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
