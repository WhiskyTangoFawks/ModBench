<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- One test project over every box until the suites are split, so the reference list is the
         solution's, not a box's. -->
    <ProjectReference Include="..\MEditService.Watcher\MEditService.Watcher.csproj" />
    <ProjectReference Include="..\MEditService.Commands\MEditService.Commands.csproj" />
    <ProjectReference Include="..\MEditService.Queries\MEditService.Queries.csproj" />
    <ProjectReference Include="..\MEditService.LoadOrder\MEditService.LoadOrder.csproj" />
    <ProjectReference Include="..\MEditService.Codec\MEditService.Codec.csproj" />
    <ProjectReference Include="..\MEditService.Ports\MEditService.Ports.csproj" />
    <ProjectReference Include="..\MEditService.Index\MEditService.Index.csproj" />
    <ProjectReference Include="..\MEditService.SourceRepo\MEditService.SourceRepo.csproj" />
    <ProjectReference Include="..\MEditService.PluginAdapter\MEditService.PluginAdapter.csproj" />
  </ItemGroup>

</Project>
