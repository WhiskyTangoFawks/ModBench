<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CA1707: Method_Scenario_Result test naming; CA1711: xUnit collection classes;
         CA1816: GC.SuppressFinalize not needed in test fixtures;
         CA1859: interface-typed fields are intentional in tests;
         CA1861: constant array args are fine in tests -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1816;CA1859;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one test project every box grants InternalsVisibleTo beside its own: a test whose
         subject reaches two boxes' internals at once, with no single box's test project able to
         hold it. Meant to shrink to nothing as a follow-up rewrites each fixture at its box's
         interface, one at a time. -->
    <ProjectReference Include="..\MEditService.Http\MEditService.Http.csproj" />
    <ProjectReference Include="..\MEditService.Watcher\MEditService.Watcher.csproj" />
    <ProjectReference Include="..\MEditService.Commands\MEditService.Commands.csproj" />
    <ProjectReference Include="..\MEditService.Queries\MEditService.Queries.csproj" />
    <ProjectReference Include="..\MEditService.LoadOrder\MEditService.LoadOrder.csproj" />
    <ProjectReference Include="..\MEditService.Codec\MEditService.Codec.csproj" />
    <ProjectReference Include="..\MEditService.Ports\MEditService.Ports.csproj" />
    <ProjectReference Include="..\MEditService.Index\MEditService.Index.csproj" />
    <ProjectReference Include="..\MEditService.SourceRepo\MEditService.SourceRepo.csproj" />
    <ProjectReference Include="..\MEditService.PluginAdapter\MEditService.PluginAdapter.csproj" />
  </ItemGroup>

</Project>
