<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CA1707: Method_Scenario_Result test naming; CA1711: xUnit collection classes;
         CA1816: GC.SuppressFinalize not needed in test fixtures;
         CA1859: interface-typed fields are intentional in tests;
         CA1861: constant array args are fine in tests -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1816;CA1859;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Roslyn's own .editorconfig resolution, so BannedApiScopeTests pins the severity the
         compiler computes rather than one this project re-derives. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MEditService.TestSupport\TestData\**" LinkBase="TestData" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- One test project per box: the drawn list plus the kernel, mirroring
         MEditService.Codec's own ProjectReference list. -->
    <ProjectReference Include="..\MEditService.Codec\MEditService.Codec.csproj" />
    <ProjectReference Include="..\MEditService.TestSupport\MEditService.TestSupport.csproj" />
  </ItemGroup>

</Project>
