<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- GitCli logs a git failure's full argument vector via Serilog's ambient Log.Logger
         (the same gateway MEditService.Http/Program.cs already sets for the whole process) rather
         than take an ILogger — there is no injected logger reaching this static class, and this is
         a single fire-and-forget diagnostic line at one throw site, not a case for wiring ILogger
         through GitCli and every SourceRepository call site above it. Version pinned to the
         transitive resolution Serilog.AspNetCore already brings into MEditService.Http, so this adds
         no second Serilog version to the solution. -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.11.0.117924">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MEditService.SourceRepo.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MEditService.Tests.ProcessEnvironment</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- The kernel, by the band's rule (ADR-0014): every Core box and driven adapter reads all three. -->
    <ProjectReference Include="..\MEditService.LoadOrder\MEditService.LoadOrder.csproj" />
    <!-- The kernel, by the band's rule (ADR-0014): every Core box and driven adapter reads all three. -->
    <ProjectReference Include="..\MEditService.Codec\MEditService.Codec.csproj" />
    <!-- The kernel, by the band's rule (ADR-0014): every Core box and driven adapter reads all three. -->
    <ProjectReference Include="..\MEditService.Ports\MEditService.Ports.csproj" />
  </ItemGroup>

</Project>
