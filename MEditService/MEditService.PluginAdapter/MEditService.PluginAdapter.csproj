<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to 0.53.x: 0.54.0 reintroduces a binary round-trip defect in the lazy
         binary-overlay reader (Fallout4ModBinaryOverlay / ModFactory.ImportGetter) — an
         alphabetized ObjectTemplate_Registration.AllRecordTypes splits every on-disk
         OBTF/FULL/OBTS template in two on read, and the write serializes the inflated list
         (FO4 weapon ObjectTemplates). This adapter's reads go through that overlay. No
         test gates a bump: move the pin forward only once the regression is confirmed fixed
         upstream. -->
    <PackageReference Include="Mutagen.Bethesda.Fallout4" Version="0.53.1" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.11.0.117924">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The kernel, by the band's rule (target-architecture.d2 medit_kernel). -->
    <ProjectReference Include="..\MEditService.LoadOrder\MEditService.LoadOrder.csproj" />
    <!-- The kernel, by the band's rule (target-architecture.d2 medit_kernel). -->
    <ProjectReference Include="..\MEditService.Codec\MEditService.Codec.csproj" />
    <!-- The band's lib (target-architecture.d2 medit_repositories). -->
    <ProjectReference Include="..\MEditService.RepositoriesLib\MEditService.RepositoriesLib.csproj" />
  </ItemGroup>

</Project>
