# Shared vocabulary for every diagram in this directory. Boxes: what a module is.
# Arrows: which gesture family the payload belongs to. Spread with `...@styles`.
classes: {
  band: {style.fill: "#f7f7f7"; style.stroke: "#cccccc"; style.font-size: 16}
  driving: {style.fill: "#dae8fc"}
  core: {style.fill: "#fff2cc"}
  driven: {style.fill: "#d5e8d4"}
  sor: {shape: cylinder; style.fill: "#e1d5e7"}
  derived: {shape: cylinder; style.fill: "#d5e8d4"}
  other: {style.fill: "#f5f5f5"}

  edit: {style.stroke: "#1f77b4"; style.font-color: "#1f77b4"; style.stroke-width: 2}
  track: {style.stroke: "#2ca02c"; style.font-color: "#2ca02c"; style.stroke-width: 2}
  compile: {style.stroke: "#ff7f0e"; style.font-color: "#ff7f0e"; style.stroke-width: 2}
  query: {style.stroke: "#7b3fa0"; style.font-color: "#7b3fa0"; style.stroke-width: 2}
  loadout: {style.stroke: "#008b8b"; style.font-color: "#008b8b"; style.stroke-width: 2}
  deploy: {style.stroke: "#8c564b"; style.font-color: "#8c564b"; style.stroke-width: 2}
  # a signal carries no payload; its label names the event
  signal: {style.stroke: "#888888"; style.font-color: "#888888"; style.stroke-dash: 4}
  # a push names what changed and nothing more; the receiver re-reads
  push: {style.stroke: "#7b3fa0"; style.font-color: "#7b3fa0"; style.stroke-dash: 4}
  outside: {style.stroke: "#666666"; style.font-color: "#666666"}

  # the reference view only: a project reference, and a read or write of a system of record
  ref: {style.stroke: "#1a1a1a"; style.stroke-width: 2}
  store: {style.stroke: "#9673a6"; style.stroke-width: 1}
}
