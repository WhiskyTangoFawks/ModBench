# The zoom-out. Row = layer, column = process; each mEdit layer sits beside its Modbench
# twin and means the same thing. A module box carries three lines: its name, its interface,
# what it hides. A cylinder is a store and carries what it holds. No arrows here: references
# are target-architecture-references.d2, and every data flow is a trace in traces/.
...@styles
grid-rows: 6
grid-columns: 2
grid-gap: 24

medit_drivers: "MEDIT · Drivers — its clients" {
  class: band; grid-rows: 1
  modbench: "Modbench\nthe right column" {class: driving}
  scripts: "Python scripts\na second HTTP client" {class: driving}
}
modbench_drivers: "MODBENCH · Drivers — the user, in VS Code's trees, panels and palette" {
  class: band; grid-rows: 1
  user: "The user\nclicks, checks, drags, types" {class: other}
}

medit_driving: "MEDIT · Driving adapters — the API" {
  class: band; grid-rows: 1
  http: "HTTP endpoints\ninterface: one endpoint per command and query; the notification\nstream\nhides: the SSE adapter of the notification port; the composition\nroot of mEdit" {class: driving}
}
modbench_driving: "MODBENCH · Driving adapters — the views: read a value, fire a command" {
  class: band; grid-rows: 1
  toolbox: "Toolbox\ninterface: game, profile, refresh, settings\nhides: nothing" {class: driving}
  mods: "Mods\ninterface: enable, disable, move, separators, uninstall,\ncreate empty mod, install, open folder, view on Nexus\nhides: the tree: separators, sort direction, the overwrite row,\nstatus badges" {class: driving}
  plugins: "Plugins\ninterface: rows and children in one tree; the plugin gestures\nhides: the join of the instance value and the client by (origin,\nfilename); the external-change notice" {class: driving}
  downloads: "Downloads\ninterface: install, upgrade, exclude, include, delete\nhides: the target pick: candidates by Nexus id, always confirmed" {class: driving}
  editor: "Editor\ninterface: open record · active record\nhides: the record panel's host · Referenced By" {class: driving}
}

medit_core: "MEDIT · Core — the write side and the read side; each references Access and the kernel" {
  class: band; grid-rows: 1
  commands: "Commands\ninterface: one handler per gesture: edit, create, delete, copy,\ndecompile, compile, put load order; each\nanswers applied or refusal, per item over a selection\nhides: resolution under the load order; the external-change\ncheck" {class: core}
  queries: "Queries\ninterface: compare, references, children, the plugin list,\nthe malformed-plugin diagnosis, the record\ntypes a game can create; set and clear the record filter · rebuild\nthe index\nhides: the Index's reads" {class: core}
}
modbench_core: "MODBENCH · Core — one command per gesture; each writes through the Instance adapter and forgets" {
  class: band; grid-rows: 1
  modlist: "modlist commands\ninterface: enable, disable, move, separators, uninstall,\ncreate empty mod, mod sync\nhides: an uninstall's mark on its downloaded file" {class: core}
  pluginscommands: "plugins commands\ninterface: enable, disable, move, plugin sync\nhides: the plugin-order rules: masters above dependants,\nblueprint plugins last" {class: core}
  instancecommands: "instance commands\ninterface: switch profile · put load order · refresh: rebuild the\nindex\nhides: nothing; the Instance adapter writes the profile" {class: core}
  downloadscommands: "downloads commands\ninterface: exclude, include, delete\nhides: nothing; the Instance adapter writes a downloaded\nfile's metadata" {class: core}
  install: "install\ninterface: new mod, upgrade\nhides: staging, then one rename into mods/; an upgrade replaces\nthe folder's contents in place around .git, .gitignore and\nsource/; the installed mark on the downloaded file" {class: core}
  deploy: "deploy commands\ninterface: deploy, purge, with the winners as an argument\nhides: the rules that refuse a deploy" {class: core}
}

medit_kernel: "MEDIT · Kernel — read by every Core box and driven adapter; a port lives here; Ports reads Load order state; nothing else in the kernel references anything" {
  class: band; grid-rows: 1
  loadorder: "Load order state\ninterface: the game release; every plugin in the instance, with its\npath; the active plugins, in load order\nhides: nothing" {class: kernel}
  codec: "Codec + schema\ninterface: text to document and back; which fields are\nreferences, children and an element's key; which record types can\nbe created\nhides: the game assemblies; Mutagen owns the typing" {class: kernel}
  ports: "Ports\ninterface: notification: publish: rows changed · plugin changed\n· index status · track progress · external change, per\nmod · untracked plugins in a tracked mod\nhides: nothing; the interface and its payloads; the endpoints\nimplement it" {class: kernel}
}
modbench_kernel: "MODBENCH · Kernel — pure; read by every Core box and driven adapter; a kernel box references nothing" {
  class: band; grid-rows: 1
  loadorderfilecodec: "Load-order file codec\ninterface: parse and byte-faithful splice of plugins.txt\nhides: the game's format, per release" {class: kernel}
  wire: "Wire\ninterface: the generated API types; the webview message protocol\nhides: nothing; generated" {class: kernel}
  tables: "per-release tables\ninterface: game paths · load-order file destination ·\nthe game's masters\nhides: every game name" {class: kernel}
  ports: "Ports\ninterface: report a failure by severity; ask one modal question\nand get the answer; a selection's outcome: what landed and each\nrefusal; the invariant lookup and the errno read; move a file to\nthe system trash\nhides: nothing; the types and the severity table (ADR-0019); the\ncomposition root implements them over the window API" {class: kernel}
}

medit_driven: "MEDIT · Driven adapters — the record index is a view over the two beside it" {
  class: band; grid-rows: 1
  index: "Record index — one deep module, rebuildable\ninterface: reads, of the active plugins only · validate by hash ·\nset and clear the record filter · rebuild · the sequence and its\nawait\nhides: the Indexer and the Store; the reconcile" {
    indexer: "Indexer\nasks the load order and the schema, decides nothing" {class: driven}
    store: "Store\nDuckDB: every plugin's rows" {class: derived}
  }
  sourceadapter: "Source adapter\ninterface: get, put, remove, rename\nhides: layout and git" {class: driven}
  pluginadapter: "Plugin adapter\ninterface: Mutagen read and write; a file's hash\nhides: the game assemblies; the stamp that skips an unchanged\nfile" {class: driven}
}
modbench_driven: "MODBENCH · Driven adapters — the Instance adapter is the one reader and writer of the instance; the instance value is derived from it by watching, and nothing else" {
  class: band; grid-rows: 1
  instanceloader: "Instance loader\ninterface: current value and the last read's failure · subscribe ·\nrefresh · sequence\nhides: the debounce; which file wins each path; which plugins are\nactive; a downloaded file's status; a read failure keeps the last\nvalue" {class: driven}
  instanceadapter: "Instance adapter — a repository; MO2 is one implementation\ninterface: parsed reads: the game and where it is, the profile,\nthe mods in order, the load order, each mod's meta, the\ndownloaded files, the game folder's plugins and its Creation Club\nlist; changes: enable or disable mods and plugins; move mods,\nseparators and plugins in their order; add or drop an entry in\nmod order or plugin order; a downloaded file's metadata, a mod's meta, the\nselected profile; get, put, rename in mods/; subscribe: the\ninstance changed\nhides: layout — the directory structure and every path function;\nthe watch; the manager's file formats, their splices and locks;\nwhole-file writes; how it finds the game folder" {class: driven}
  deployment: "deployment\ninterface: write, remove\nhides: the deployment model and what it writes into the game\nfolder" {class: driven}
  client: "mEdit client\ninterface: commands, one per handler, each applied or refusal ·\nqueries · subscribe by kind · put load order · start, stop,\nstatus\nhides: the HTTP adapter and the in-memory adapter; the process\n(ADR-0002)" {class: core}
}

medit_data: "MEDIT · Systems of record" {
  class: band; grid-rows: 1
  source: "Source tree in git" {class: sor}
  plugin: "Plugin files" {class: sor}
  tools: "Other tools\nMO2, xEdit, CK, the game — at any time" {class: other}
}
modbench_data: "MODBENCH · Systems of record; mEdit is the left column and always running" {
  class: band; grid-rows: 1
  mo2: "MO2 instance\nprofiles/*/modlist.txt, plugins.txt · ModOrganizer.ini ·\nmods/*/meta.ini · mods/ · overwrite/ · downloads/" {class: sor}
  gamedata: "Game folder\nthe game's own plugins and files" {class: sor}
  tools: "Other tools\nMO2, the user, the game — at any time" {class: other}
  medit: "mEdit\nthe left column" {class: driving}
}
