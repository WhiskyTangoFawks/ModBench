# The zoom-out. Row = layer, column = process; each mEdit layer sits beside its Modbench
# twin and means the same thing. A module box carries its name, its purpose and, when it has
# one, its secret. A cylinder is a store and carries what it holds. No arrows here: the layer
# rule is layers.d2, a reference is a line in a project file, and every data flow is a trace.
...@styles
grid-rows: 7
grid-columns: 2
grid-gap: 24

medit_drivers: "MEDIT · Drivers — its clients" {
  class: band; grid-rows: 1
  modbench: "Modbench\nthe right column" {class: driving}
  scripts: "Python scripts\na second HTTP client" {class: driving}
}
modbench_drivers: "MODBENCH · Drivers — the user, in VS Code's trees, panels and palette" {
  class: band; grid-rows: 1
  user: "The user\nclicks, checks, drags, types" {class: other}
  activation: "Activation\nowns: wiring" {class: driving}
}

medit_driving: "MEDIT · Driving adapters — the API" {
  class: band; grid-rows: 1
  http: "HTTP endpoints\nowns: mEdit's API, and its composition root\nhides: the protocol" {class: driving}
}
modbench_driving: "MODBENCH · Driving adapters — the views: read a value, fire a command" {
  class: band; grid-rows: 1
  toolbox: "Toolbox\nowns: the instance at a glance" {class: driving}
  mods: "Mods\nowns: the mods and their conflicts, as the user sees them" {class: driving}
  plugins: "Plugins\nowns: the Plugins tree, as the user sees it\nhides: how mEdit's answers meet the instance" {class: driving}
  downloads: "Downloads\nowns: the downloaded files, as the user sees them" {class: driving}
  editor: "Editor\nowns: a record, opened to read and edit" {class: driving}
  webview: "Webview pages\nowns: the pages a view draws in a webview\nhides: the grid" {class: driving}
  sourcelanguage: "Source language\nowns: VS Code's language features over plugin source\nhides: the map from a text position to a FormKey" {class: driving}
}

medit_core: "MEDIT · Core — the write side; it references the kernel and the repositories" {
  class: band; grid-rows: 1
  commands: "Commands\nowns: the write side\nhides: the rules that decide a write" {class: core}
}
modbench_core: "MODBENCH · Core — one command per gesture; each writes through the Instance adapter and forgets" {
  class: band; grid-rows: 1
  modlist: "modlist commands\nowns: the mod order" {class: core}
  pluginscommands: "plugins commands\nowns: changes to the plugin order\nhides: the plugin-order rules" {class: core}
  instancecommands: "instance commands\nowns: changes to the instance as a whole" {class: core}
  downloadscommands: "downloads commands\nowns: changes to the downloaded files" {class: core}
  install: "install\nowns: putting a mod's files into the instance\nhides: extraction" {class: core}
  deploy: "deploy commands\nowns: changes to the deployment" {class: core}
}

medit_kernel: "MEDIT · Kernel — read by the core, the read model and the repositories; a port lives here; Ports reads Load order state; nothing else in the kernel references anything" {
  class: band; grid-rows: 1
  loadorder: "Load order state\nowns: the load order Mod Management hands Editing" {class: kernel}
  codec: "Codec + schema\nowns: a record as text and as document\nhides: how a document is spelled as text" {class: kernel}
  ports: "Ports\nowns: how mEdit tells its clients what changed" {class: kernel}
}
modbench_kernel: "MODBENCH · Kernel — pure; read by the core, the read model and the repositories; a kernel box references nothing" {
  class: band; grid-rows: 1
  loadorderfilecodec: "Load-order file codec\nowns: plugins.txt as text\nhides: its format" {class: kernel}
  wire: "Wire\nowns: the API types and the webview protocol" {class: kernel}
  tables: "per-release tables\nowns: what differs per game release\nhides: every game name" {class: kernel}
  ports: "Ports\nowns: how the core reaches the user and VS Code" {class: kernel}
}

medit_readmodel: "MEDIT · Read model — the record index, a view over the repositories below it" {
  class: band; grid-rows: 1
  index: "Record index — one deep module, rebuildable\nowns: the read model over every plugin\nhides: how records are stored and kept current" {
    queries: "Queries\nthe face: what the API asks of the read model" {class: readmodel}
    indexer: "Indexer\nasks the load order and the schema, decides nothing" {class: readmodel}
    store: "Store\nDuckDB: every plugin's rows" {class: derived}
  }
}
modbench_readmodel: "MODBENCH · Read model — the instance value, derived from the Instance adapter by watching, and nothing else" {
  class: band; grid-rows: 1
  instanceloader: "Instance loader\nowns: the instance value, recomputed whole on every change" {class: readmodel}
}

medit_repositories: "MEDIT · Repositories — the only boxes that read or write a system of record" {
  class: band; grid-rows: 1
  sourceadapter: "Source adapter\nowns: a tracked plugin's source tree\nhides: layout and git" {class: repositories}
  pluginadapter: "Plugin adapter\nowns: the plugin files\nhides: the binary format" {class: repositories}
}
modbench_repositories: "MODBENCH · Repositories — the Instance adapter is the one reader and writer of the instance" {
  class: band; grid-rows: 1
  instanceadapter: "Instance adapter — MO2 is one implementation\nowns: the instance\nhides: the mod manager" {class: repositories}
  deployment: "deployment\nowns: making the game see the instance\nhides: the deployment model" {class: repositories}
  client: "mEdit client\nowns: Modbench's one reach to mEdit\nhides: the transport and the process" {class: repositories}
}

medit_data: "MEDIT · Systems of record" {
  class: band; grid-rows: 1
  source: "Source tree in git" {class: sor}
  plugin: "Plugin files" {class: sor}
  tools: "Other tools\nthe mod manager, xEdit, CK, the game — at any time" {class: other}
}
modbench_data: "MODBENCH · Systems of record; mEdit is the left column and always running" {
  class: band; grid-rows: 1
  instance: "Instance\nthe mod manager's files · each profile's plugins.txt ·\nmods · Overwrite · downloaded files" {class: sor}
  gamedata: "Game folder\nthe game's own plugins and files" {class: sor}
  tools: "Other tools\nthe mod manager, the user, the game — at any time" {class: other}
  medit: "mEdit\nthe left column" {class: driving}
}
