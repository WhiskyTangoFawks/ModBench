# The master data-flow view: the zoom-out's boxes with every arrow, coloured by gesture
# family and unlabelled. Labels live in traces/, one file per family; this picture is
# the topology. Arrows are straight because the boxes sit in a grid.
...@target-architecture
grid-rows: 7
grid-columns: 2
me1.modbench: null
mb6.medit: null
me1: "MEDIT · Front end — its clients; Modbench is the right column, its client the seam"

# edit
mb2.editor -> mb3.client {class: edit}
mb2.plugins -> mb3.client {class: edit}
mb3.client -> me2.http {class: edit}
me1.scripts -> me2.http {class: edit}
me2.http -> me3.cmd {class: edit}
me5.srcrepo -> me3.cmd {class: edit}
me3.cmd -> me5.srcrepo {class: edit}
me6.source -> me5.srcrepo {class: edit}
me5.srcrepo -> me6.source {class: edit}
# track and absorb
me6.plugin -> me5.plgadapter {class: track}
me5.plgadapter -> me3.cmd {class: track}
# compile and keep
me3.cmd -> me5.plgadapter {class: compile}
me5.plgadapter -> me6.plugin {class: compile}
# kernel facts, projection and query
me2.http -> me4.loadorder {class: query}
me4.loadorder -> me3.cmd {class: query}
me4.codec -> me3.cmd {class: query}
me4.loadorder -> me5.index.proj {class: query}
me4.codec -> me5.index.proj {class: query}
me5.srcrepo -> me5.index.proj {class: query}
me5.plgadapter -> me5.index.proj {class: query}
me5.index.proj -> me5.index.store {class: query}
me5.index.store -> me3.qry {class: query}
me2.http -> me3.qry {class: query}
me3.qry -> me2.http {class: query}
me1.panel -> me2.http {class: query}
mb3.pluginscmd -> mb3.client {class: query}
mb3.client -> mb3.pluginscmd {class: query}
# push
me5.index -> me3.port {class: push}
me2.watcher -> me3.port {class: push}
me3.port -> me2.http {class: push}
me2.http -> mb3.client {class: push}
me2.http -> me1.panel {class: push}
mb3.client -> mb2.plugins {class: push}
mb3.client -> mb2.editor {class: push}
# signals
me6.plugin -> me2.watcher {class: signal}
me6.source -> me2.watcher {class: signal}
me2.watcher -> me5.index.proj {class: signal}
me2.http -> me5.index {class: signal}
mb6.mo2 -> mb5.instance {class: signal}
mb6.gamedata -> mb5.instance {class: signal}
mb6.mo2 -> me2.watcher {class: signal}
# loadout
mb1.user -> mb2 {class: outside}
mb5.instance -> mb2.toolbox {class: loadout}
mb5.instance -> mb2.mods {class: loadout}
mb5.instance -> mb2.plugins {class: loadout}
mb5.instance -> mb2.downloads {class: loadout}
mb2.mods -> mb3.modlist {class: loadout}
mb2.plugins -> mb3.pluginscmd {class: loadout}
mb2.toolbox -> mb3.instance {class: loadout}
mb2.downloads -> mb3.install {class: loadout}
mb5.instance -> mb3.modlist {class: loadout}
mb5.instance -> mb3.pluginscmd {class: loadout}
mb3.modlist -> mb4.modlist {class: loadout}
mb3.pluginscmd -> mb4.plugins {class: loadout}
mb3.instance -> mb4.ini {class: loadout}
mb3.install -> mb4.meta {class: loadout}
mb3.install -> mb6.mo2 {class: loadout}
mb4.modlist -> mb6.mo2 {class: loadout}
mb4.plugins -> mb6.mo2 {class: loadout}
mb4.ini -> mb6.mo2 {class: loadout}
mb4.meta -> mb6.mo2 {class: loadout}
mb4.modlist -> mb5.instance {class: loadout}
mb4.plugins -> mb5.instance {class: loadout}
mb4.meta -> mb5.instance {class: loadout}
mb4.ini -> mb5.instance {class: loadout}
mb4.tables -> mb5.instance {class: loadout}
mb5.instance -> mb3.client {class: loadout}
mb3.client -> me2.http {class: loadout}
# deploy
mb4.tables -> mb2.toolbox {class: deploy}
mb2.toolbox -> mb6.gamedata {class: deploy}
# outside
me6.tools -> me6.plugin {class: outside}
mb6.tools -> mb6.mo2 {class: outside}

legend: "Arrows point the way data moves. Colour is the gesture family; the trace of that name carries the labels." {
  class: band; grid-rows: 1
  edit: "edit" {class: edit}
  track: "track · absorb" {class: track}
  compile: "compile · keep" {class: compile}
  query: "kernel facts · project · query" {class: query}
  push: "push: a notification" {class: push}
  loadout: "loadout: command or value" {class: loadout}
  deploy: "deploy" {class: deploy}
  signal: "signal: watch or result, no payload" {class: signal}
  outside: "the user or another tool, at any time" {class: outside}
}
reading: "A box talks to the band beneath it, and to the kernel. Change flows up only through a watcher or the notification port. A command writes a file and forgets; the read model beside it learns by watching, and no command reads it: a value it needs arrives as an argument. The two columns meet at the load order snapshot and the stream." {
  class: band
}
