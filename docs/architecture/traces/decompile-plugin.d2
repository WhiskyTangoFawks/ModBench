# Decompile plugin, green.
...@../styles
shape: sequence_diagram
plugins: @../target-architecture.modbench_driving.plugins
plugins.label: Plugins
client: @../target-architecture.modbench_driven.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
port: @../target-architecture.medit_kernel.ports
port.label: Ports
plugin: @../target-architecture.medit_data.plugin
pluginadapter: @../target-architecture.medit_driven.pluginadapter
pluginadapter.label: Plugin adapter
sourceadapter: @../target-architecture.medit_driven.sourceadapter
sourceadapter.label: Source adapter
source: @../target-architecture.medit_data.source
indexer: @../target-architecture.medit_driven.index.indexer
indexer.label: Indexer

plugins -> client: "decompile plugin: track, with the preset · decompile" {class: edit}
client -> http: envelope {class: edit}
http -> commands: envelope {class: edit}
plugin -> pluginadapter: bytes {class: track}
pluginadapter -> commands: bytes {class: track}
commands."the round-trip gate, per plugin"
commands -> sourceadapter: documents, per plugin {class: track}
commands -> port: track progress, per plugin {class: push}
sourceadapter -> source: documents {class: track}

baseline: "the repository" {
  sourceadapter."a new repository, with baseline commits · a tracked mod: the working tree"
}

commands -> http: "applied or refusal, per item" {class: edit}
http -> client: "applied or refusal, per item" {class: edit}
client -> plugins: the outcome {class: edit}
indexer."the next snapshot: index-load-order"


refused: "refused, nothing of that plugin written" {
  commands -> http: "the refusal" {class: edit}
  http -> client: the refusal {class: edit}
  client -> plugins: the refusal {class: edit}
}
