# Decompile plugin, green. Contract: decompile-plugin.md.
...@../styles
shape: sequence_diagram
tools: "MO2 · another tool · the user" {class: other}
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "the mod's folder"
watcher: @../target-architecture.medit_driving.watcher
watcher.label: Mod watcher
plugins: @../target-architecture.modbench_driving.plugins
plugins.label: Plugins
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
port: @../target-architecture.medit_kernel.ports
port.label: Ports
plugin: @../target-architecture.medit_data.plugin
pluginadapter: @../target-architecture.medit_driven.pluginadapter
pluginadapter.label: Plugin adapter
sourceadapter: @../target-architecture.medit_driven.sourceadapter
sourceadapter.label: Source adapter
source: @../target-architecture.medit_data.source
indexer: @../target-architecture.medit_driven.index.indexer
indexer.label: Indexer

the trigger: "the system trigger: which destination" {
  tools -> mo2: bytes, at any time {class: outside}
  mo2 -> watcher: changed paths {class: signal}
  watcher."settle per mod, then classify: tracked plugins' bytes vs the parked ref · git status of tracked files"
  watcher -> commands: a tracked mod settled {class: signal}
  commands -> port: "external change pending: mod, what changed · untracked plugins" {class: push}
  port -> http: publish {class: push}
  http -> client: stream {class: push}
  client -> plugins: "external change pending · untracked plugins" {class: push}
  plugins."one dialog per mod: Commit to main as new baseline · Apply to working tree on <branch> · Esc defers, and every write to the mod is refused until it is answered · an untracked plugin: a warning"
}

plugins -> client: "decompile plugin: to the repository (track) · to main · to the working tree" {class: edit}
client -> http: envelope {class: edit}
http -> commands: envelope {class: edit}
plugin -> pluginadapter: bytes {class: track}
pluginadapter -> commands: bytes {class: track}
commands."the round-trip gate, per plugin, before any of it is written"
commands -> sourceadapter: documents, per plugin {class: track}
commands -> port: track progress, per plugin {class: push}
sourceadapter -> source: documents {class: track}

baseline: "the repository or main" {
  sourceadapter."one baseline commit per plugin, by plumbing, trailers from meta.ini; the edit branch moves only in a repository this run created"
}

commands -> http: "applied or refusal, per item" {class: edit}
http -> client: "applied or refusal, per item" {class: edit}
client -> plugins: the outcome {class: edit}
source -> watcher: source changed {class: signal}
watcher -> indexer: source changed {class: signal}
sourceadapter -> indexer: documents (tracked) {class: query}

rebase: "rebase edit branch" {
  plugins -> client: rebase edit branch {class: edit}
  client -> http: envelope {class: edit}
  http -> commands: envelope {class: edit}
  commands -> sourceadapter: "rebase the edit branch onto main" {class: edit}
  sourceadapter -> commands: "clean · refused (paths) · conflicted (files)" {class: edit}
  commands -> http: the outcome {class: edit}
  http -> client: the outcome {class: edit}
  client -> plugins: the outcome {class: edit}
  plugins."refused: the paths · conflict: the native merge editor"
}

refused: "refused, nothing of that plugin written" {
  commands -> http: "git not on the PATH · a plugin in no mod · the bytes cannot be parsed · a record fails the round trip, naming it · a missing strings file · a record already changed, naming the records" {class: edit}
  http -> client: the refusal {class: edit}
  client -> plugins: the refusal {class: edit}
}
