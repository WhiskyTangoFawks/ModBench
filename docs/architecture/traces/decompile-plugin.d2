# Decompile plugin. It reads a plugin's bytes into documents, all of them, once, and puts them
# at a destination: a new repository, main, or the working tree. Two things fire it. The gesture
# track asks for a new repository. The system trigger is the watcher settling a tracked mod
# that changed: one classification per mod, against git and never the event list, and meta.ini
# is a tell that pre-selects the default, never a trigger. A moved version means a new release,
# so the destination is main; no meta change means an edit in another tool, so it is the working
# tree. The human is asked first: one dialog per mod. After a commit to main
# the rebase is attempted at once, and the baseline stands whatever the rebase does.
# Governed by ADR-0003, ADR-0006, ADR-0007 and ADR-0008. Contract: decompile-plugin.md.
...@../styles
shape: sequence_diagram
tools: "MO2 · another tool · the user" {class: other}
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "the mod's folder"
watcher: @../target-architecture.medit_driving.watcher
watcher.label: Mod watcher
plugins: @../target-architecture.modbench_driving.plugins
plugins.label: Plugins
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
port: @../target-architecture.medit_kernel.ports
port.label: Ports
plugin: @../target-architecture.medit_data.plugin
pluginadapter: @../target-architecture.medit_driven.pluginadapter
pluginadapter.label: Plugin adapter
sourceadapter: @../target-architecture.medit_driven.sourceadapter
sourceadapter.label: Source adapter
source: @../target-architecture.medit_data.source
indexer: @../target-architecture.medit_driven.index.indexer
indexer.label: Indexer

the trigger: "the system trigger: which destination" {
  tools -> mo2: bytes, at any time {class: outside}
  mo2 -> watcher: changed paths {class: signal}
  watcher."settle per mod, then classify: plugin bytes vs the parked ref · git status of tracked files · meta hash as the tell"
  watcher -> commands: a tracked mod settled {class: signal}
  commands -> port: "external change pending: mod, what changed, the default" {class: push}
  port -> http: publish {class: push}
  http -> client: stream {class: push}
  client -> plugins: external change pending {class: push}
  plugins."one dialog per mod: Commit to main as new baseline · Apply to working tree on <branch> · Esc defers, and every write to the mod is refused until it is answered"
}

plugins -> client: "decompile plugin: to a new repository (track) · to main · to the working tree" {class: edit}
client -> http: envelope {class: edit}
http -> commands: envelope {class: edit}
plugin -> pluginadapter: bytes {class: track}
pluginadapter -> commands: bytes {class: track}
commands."round-trip gate over the tree it wrote"
commands -> sourceadapter: all documents {class: track}
commands -> port: track progress, per plugin {class: push}
sourceadapter -> source: documents {class: track}

to main: "the destination is main" {
  sourceadapter."commit the baseline by plumbing, trailers from meta.ini, then rebase the edit branch"
  sourceadapter -> commands: "rebase: clean · refused (paths) · conflicted (files)" {class: edit}
}

commands -> http: "applied or refusal, per item" {class: edit}
http -> client: "applied or refusal, per item" {class: edit}
client -> plugins: the outcome {class: edit}
plugins."clean: silent · refused: the paths, pointing at rebase edit branch · conflict: the native merge editor"
source -> watcher: source changed {class: signal}
watcher -> indexer: source changed {class: signal}
sourceadapter -> indexer: documents (tracked) {class: query}

refused: "refused, nothing written" {
  commands -> http: "a dropped subrecord, naming it · a missing strings file · git not on the PATH · a record already changed, naming the records" {class: edit}
  http -> client: the refusal {class: edit}
  client -> plugins: the refusal {class: edit}
}
