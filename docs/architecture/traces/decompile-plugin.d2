sourceadapter -> source: documents {class: track}

baseline: "the repository" {
  sourceadapter."a new repository: the mod's own files, then one baseline commit per plugin, trailers from the request · an existing one: the working tree, no commit"
}

commands -> http: "applied or refusal, per item" {class: edit}
