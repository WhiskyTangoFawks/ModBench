# Create a plugin, blue.
...@../styles
shape: sequence_diagram
plugins: @../target-architecture.modbench_driving.plugins
plugins.label: Plugins
client: @../target-architecture.modbench_driven.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
pluginadapter: @../target-architecture.medit_driven.pluginadapter
pluginadapter.label: Plugin adapter
plugin: @../target-architecture.medit_data.plugin
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nplugins.txt · mods/ · overwrite/"
instanceloader: @../target-architecture.modbench_driven.instanceloader
instanceloader.label: Instance loader
pluginscommands: @../target-architecture.modbench_core.pluginscommands
pluginscommands.label: plugins commands
watcher: @../target-architecture.medit_driving.watcher
watcher.label: Mod watcher

plugins."the name, then the place"
plugins -> client: "create: origin, name, folder" {class: edit}
client -> http: envelope {class: edit}
http -> commands: envelope {class: edit}
commands -> pluginadapter: "an empty plugin: name, path, release" {class: edit}
pluginadapter -> plugin: bytes {class: edit}
pluginadapter -> commands: written or refusal {class: edit}
commands -> http: applied or refusal {class: edit}
http -> client: applied or refusal {class: edit}
client -> plugins: applied or refusal {class: edit}
mo2 -> instanceloader: watch {class: signal}
instanceloader -> pluginscommands: "plugin sync: update-load-order-file" {class: loadorder}
plugin -> watcher: changed paths {class: signal}
watcher."a tracked mod: detect-external-change from here"

refused: "refused, before any write" {
  commands -> http: "the refusal" {class: edit}
}
