# Load the instance. Contract: load-instance.md.
...@../styles
shape: sequence_diagram
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nprofiles/*/modlist.txt, plugins.txt · ModOrganizer.ini · mods/*/meta.ini · mods/ · overwrite/ · downloads/"
instanceloader: @../target-architecture.modbench_driven.instanceloader
instanceloader.label: Instance loader
instanceadapter: @../target-architecture.modbench_driven.instanceadapter
instanceadapter.label: Instance adapter
views: "Toolbox · Mods · Plugins · Downloads" {class: driving}
toolbox: @../target-architecture.modbench_driving.toolbox
toolbox.label: Toolbox
instancecommands: @../target-architecture.modbench_core.instancecommands
instancecommands.label: instance commands
client: @../target-architecture.modbench_core.client
client.label: mEdit client

mo2 -> instanceloader: "watch: every file and folder, debounced" {class: signal}
instanceloader -> instanceadapter: "get: ModOrganizer.ini first · modlist.txt · plugins.txt · meta.ini · the downloads' .meta · the game folder's plugins" {class: loadorder}
instanceadapter -> instanceloader: "parsed: the game, the profile, the mods in order, the load order, each mod's meta, the downloaded files, the game folder's plugins" {class: loadorder}
instanceloader."one immutable value, replaced whole; sequence +1; a read failure keeps the last"
instanceloader -> views: "value · the last read's failure, if any" {class: loadorder}
instanceloader -> instancecommands: "put load order: the snapshot as an argument, on change" {class: loadorder}
instancecommands -> client: load order snapshot {class: loadorder}

refresh: "refresh, from the Toolbox" {
  toolbox -> instancecommands: refresh {class: loadorder}
  instancecommands -> client: "rebuild the index" {class: loadorder}
  client -> instancecommands: applied or refusal {class: loadorder}
  instancecommands."a refused rebuild stops here: nothing sent, nothing read again"
  instancecommands -> toolbox: applied or refusal {class: loadorder}
  toolbox -> instanceloader: "refresh: read every file again" {class: loadorder}
}
