# Edit a record, blue.
...@../styles
shape: sequence_diagram
editor: "Plugins · Editor" {class: driving}
client: @../target-architecture.modbench_repositories.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
queries: @../target-architecture.medit_readmodel.index.queries
queries.label: Queries
commands: @../target-architecture.medit_core.commands
commands.label: Commands
source: @../target-architecture.medit_data.source
sourceadapter: @../target-architecture.medit_repositories.sourceadapter
sourceadapter.label: Source adapter
vscode: "VS Code" {class: other}

create: "create: the type pick first" {
  editor -> client: "on a plugin, the record types the game can create; on a container, the types it holds" {class: query}
  client -> http: question {class: query}
  http -> queries: question {class: query}
  queries -> http: "answer: the record types" {class: query}
  http -> client: answer {class: query}
  client -> editor: the record types {class: query}
}

editor -> client: "the gesture: its Argument, its Options and any unsaved document text" {class: edit}
client -> http: envelope {class: edit}
http -> commands: envelope {class: edit}
source -> sourceadapter: documents {class: edit}
sourceadapter -> commands: "the documents it reads" {class: edit}
commands."writes nothing"
commands -> http: "each document's new text, each create, delete and move, per item" {class: edit}
http -> client: "the changes, per item" {class: edit}
client -> editor: "the changes, per item" {class: edit}
editor -> vscode: "the changes, as one workspace edit, then save" {class: outside}
vscode -> source: "the saved files" {class: outside}

refused: "refused, nothing changes for that record" {
  commands -> http: "the refusal" {class: edit}
  http -> client: the refusal {class: edit}
  client -> editor: the refusal {class: edit}
}
