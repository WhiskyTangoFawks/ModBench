# Edit a record, blue. Contract: edit-record_draft.md.
...@../styles
shape: sequence_diagram
editor: "Plugins · Editor" {class: driving}
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
sourceadapter: @../target-architecture.medit_driven.sourceadapter
sourceadapter.label: Source adapter
source: @../target-architecture.medit_data.source
watcher: @../target-architecture.medit_driving.watcher
watcher.label: Mod watcher
indexer: @../target-architecture.medit_driven.index.indexer
indexer.label: Indexer
store: @../target-architecture.medit_driven.index.store
store.label: Store
port: @../target-architecture.medit_kernel.ports
port.label: Ports

editor -> client: "the gesture: the records and its Options" {class: edit}
client -> http: envelope {class: edit}
http -> commands: envelope {class: edit}
source -> sourceadapter: documents {class: edit}
sourceadapter -> commands: current document {class: edit}
commands -> sourceadapter: new document {class: edit}
sourceadapter -> source: documents {class: edit}
commands -> http: "applied or refusal, per item" {class: edit}
http -> client: "applied or refusal, per item" {class: edit}
client -> editor: "applied or refusal, per item" {class: edit}
source -> watcher: source changed {class: signal}
watcher -> indexer: "source changed: refresh keys" {class: signal}
sourceadapter -> indexer: documents (tracked) {class: query}
indexer -> store: rows {class: query}
store -> port: "rows changed: keys, sequence" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> editor: rows changed (push), then re-read {class: push}

refused: "refused, nothing written for that record" {
  commands -> http: "untracked · in no mod · a losing copy · a question open on the mod · the record has gone · a path not there · a value the codec rejects · a duplicate key · a read-only field · no free FormID · the destination holds the record, with no replace" {class: edit}
  http -> client: the refusal {class: edit}
  client -> editor: the refusal {class: edit}
}
