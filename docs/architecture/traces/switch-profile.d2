# Loadout gesture. The profile is a line in ModOrganizer.ini; the write is forgotten and
# the watch does the rest, so the new profile's files are read the same way as any other
# change.
...@../styles
shape: sequence_diagram
toolbox: @../target-architecture.modbench_driving.toolbox
toolbox.label: Toolbox
instancecommands: @../target-architecture.modbench_core.instancecommands
instancecommands.label: instance commands
codecs: @../target-architecture.modbench_kernel.codecs
codecs.label: MO2 file codecs
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nModOrganizer.ini"
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance
views: "every view" {class: driving}
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
loadorder: @../target-architecture.medit_kernel.loadorder
loadorder.label: "Load order state\nmEdit"

toolbox -> instancecommands: switch profile {class: loadout}
instancecommands -> codecs: "ModOrganizer.ini: profile name" {class: loadout}
codecs -> mo2: bytes, then forget {class: loadout}
mo2 -> instance: watch {class: signal}
instance."recompute from the new profile"
instance -> views: value {class: loadout}
instance -> client: load order snapshot {class: loadout}
client -> http: load order snapshot {class: loadout}
http -> loadorder: load order snapshot {class: loadout}
