# The invariant both processes share: a change from another tool and a change from
# Modbench are the same signal, because each read model learns only by watching.
...@../styles
shape: sequence_diagram
tools: @../target-architecture.medit_data.tools
tools.label: "Other tools\nMO2, xEdit, CK, the game, the user"
mo2: @../target-architecture.modbench_data.mo2
mo2.label: MO2 instance
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance
views: "every view" {class: driving}
plugin: @../target-architecture.medit_data.plugin
watcher: @../target-architecture.medit_driving.watcher
watcher.label: Mod watcher
commands: @../target-architecture.medit_core.commands
commands.label: Commands
projector: @../target-architecture.medit_driven.index.projector
projector.label: Projector
store: @../target-architecture.medit_driven.index.store
store.label: Store
port: @../target-architecture.medit_kernel.ports
port.label: Ports
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
client: @../target-architecture.modbench_core.client
client.label: mEdit client

tools -> mo2: files and lines, at any time {class: outside}
mo2 -> instance: "watch: every file and folder" {class: signal}
instance -> views: value {class: loadorder}
tools -> plugin: bytes, at any time {class: outside}
plugin -> watcher: bytes {class: signal}
watcher -> projector: "plugin changed: validate by hash" {class: signal}
watcher -> commands: settle the tracked mod {class: signal}
commands -> port: external change pending (tracked mod) {class: push}
projector -> store: rows {class: query}
store -> port: "plugin changed, then rows changed" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> views: rows changed (push), then re-read {class: push}
