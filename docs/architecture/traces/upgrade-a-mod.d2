# Upgrade a tracked mod, end to end (#813). One gesture, install, that knows it is an
# upgrade because the Nexus mod id is already installed. The target is always confirmed,
# pre-selected by file id, never by filename. The write replaces the folder's contents in
# place around .git. From there it is a-tracked-mod-changes-on-disk, with the version tell
# pre-selecting the baseline button; versions of a tracked mod are history on main.
...@../styles
direction: down
downloads: "Downloads view\ninstall this" {class: driving}
instance: "Instance\nmods with this Nexus id, their installedFiles" {class: driven}
pick: "Downloads view\nthe pick: candidates + new mod, pre-selected by file id, confirmed" {class: driving}
install: "install\nupgrade: target as an argument" {class: core}
meta: "meta.ini\nwrite, with installedFiles" {class: core}
mod: "Tracked mod folder\ncontents replaced in place; .git kept" {class: sor}
views: "every view" {class: driving}
watcher: "Mod watcher\nmEdit" {class: driving}
dialog: "Plugins view\nthe dialog, baseline pre-selected: the version moved" {class: driving}
main: "main\nnew baseline commit, version in the trailer; edit branch rebased" {class: sor}

downloads -> pick: gesture, with the sidecar's mod id and file id {class: loadout}
instance -> pick: value {class: loadout}
pick -> install: the confirmed target {class: loadout}
install -> meta: the meta it knows {class: loadout}
meta -> install: bytes {class: loadout}
install -> mod: staged tree in, old files out, then forget {class: loadout}
mod -> instance: watch {class: signal}
instance -> views: value {class: loadout}
mod -> watcher: changed paths {class: signal}
watcher -> dialog: "a-tracked-mod-changes-on-disk" {class: push}
dialog -> main: commit to main as new baseline, then rebase {class: track}
