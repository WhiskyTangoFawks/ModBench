# Restore from manifest, orange: each mod's folder made what its manifest says; a source mod with a remote rebuilt from its source at the commit.
...@../styles
shape: sequence_diagram
driving: "Mods · Source Control · Toolbox" {class: driving}
sourcecommands: @../target-architecture.modbench_core.sourcecommands
sourcecommands.label: source commands
instance: @../target-architecture.modbench_data.instance
instance.label: "Instance\nmods · downloaded files · the repository"
client: @../target-architecture.modbench_repositories.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
engine: @../target-architecture.medit_core.commands.engine
engine.label: Build engine
modfolder: @../target-architecture.medit_data.modfolder
modfolder.label: "Mod folders\nfiles · manifests · the stat cache"
modfolderadapter: @../target-architecture.medit_repositories.modfolderadapter
modfolderadapter.label: Mod folder adapter
source: @../target-architecture.medit_data.source
source.label: Mod source
sourceadapter: @../target-architecture.medit_repositories.sourceadapter
sourceadapter.label: Source adapter
port: @../target-architecture.medit_kernel.ports
port.label: Ports
instanceadapter: @../target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
instanceloader: @../target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
views: "every view" {class: driving}

driving -> sourcecommands: "restore from manifest: the mods, or every mod" {class: compile}
sourcecommands -> client: "what restore destroys: the mods" {class: query}
client -> http: envelope {class: query}
http -> modfolderadapter: "what restore destroys: the mods" {class: query}
modfolder -> modfolderadapter: "each manifest · each mod's files: stamps · the stat cache" {class: query}
modfolderadapter -> http: "each file that differs · each file no line names" {class: query}
http -> client: the listing {class: query}
client -> sourcecommands: the listing {class: query}
sourcecommands -> driving: "the listing" {class: compile}
driving."the confirmation, when the listing holds a file"
driving -> sourcecommands: "confirmed" {class: compile}
instance -> instanceadapter: "each downloaded file: bytes, when its index is stale" {class: compile}
instanceadapter -> sourcecommands: "each mod's folder · each installation file: hash and entries · the game folder · each game file a mod file overrides: hash" {class: compile}
sourcecommands -> client: "restore: each mod's folder and installation files with their hashes and entries, the game folder" {class: compile}
client -> http: envelope {class: compile}
http -> engine: envelope {class: compile}
modfolder -> modfolderadapter: "each manifest · installation files, game files: bytes" {class: compile}
modfolderadapter -> engine: "manifests and bytes" {class: compile}

sourcemod: "a source mod with a remote" {
  source -> sourceadapter: "the commit at HEAD, or absent" {class: compile}
  sourceadapter -> engine: "the commit" {class: compile}
  engine -> sourceadapter: "clone at the manifest's commit, when absent" {class: compile}
  sourceadapter -> source: "the clone" {class: compile}
  engine."build-mod at the manifest's commit; skipped and named when the source is at another commit"
}

engine."per mod: every file whose bytes differ is written; a mod that lacks anything is skipped"
engine -> port: "progress, per mod" {class: push}
client -> http: "cancel: the gesture, after its first progress" {class: compile}
http -> engine: "stop after the mod in hand" {class: compile}
engine -> modfolderadapter: "each file whose bytes differ" {class: compile}
modfolderadapter -> modfolder: "the files · the stat cache" {class: compile}
engine -> http: "landed or skipped, per mod, with what it lacks · each file no line names" {class: compile}
http -> client: "landed or skipped, per mod, with what it lacks · each file no line names" {class: compile}
client -> sourcecommands: the outcome {class: compile}
sourcecommands -> instanceadapter: "each file no line names, to the trash" {class: compile}
instanceadapter -> instance: "the trash" {class: compile}
sourcecommands -> driving: "the outcome" {class: compile}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
