# Deploy the mods, and purge them. Both commands take one instance value, with its sequence, as an argument and
# write Game Data/ through the Instance adapter; the manifest is Game Data's hash and an input to the Instance loader, so
# deploy state comes back the same way as everything else. What purge does with files Modbench did
# not deploy waits for its design session.
# Governed by ADR-0002, ADR-0003, ADR-0016 and ADR-0017. The rules are in deploy.md.
...@../styles
shape: sequence_diagram
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance loader
toolbox: @../target-architecture.modbench_driving.toolbox
toolbox.label: Toolbox
deploy: @../target-architecture.modbench_core.deploy
deploy.label: deploy commands
tables: @../target-architecture.modbench_kernel.tables
tables.label: per-release tables
mo2files: @../target-architecture.modbench_driven.mo2files
mo2files.label: Instance adapter
gamedata: @../target-architecture.modbench_data.gamedata
gamedata.label: Game Data/

instance -> toolbox: one value, with its sequence {class: loadorder}
toolbox."confirms every deploy and every purge. Esc stops"
toolbox -> deploy: "deploy · purge, with the value" {class: deploy}
tables -> deploy: load-order file destination {class: deploy}
deploy -> mo2files: "the hardlinks to make, or the links to remove · the manifest" {class: deploy}
mo2files -> gamedata: hardlinks or their removal · manifest, then forget {class: deploy}
gamedata -> instance: "watch: the manifest" {class: signal}
instance -> toolbox: value, deploy state {class: loadorder}

link fails: "a link fails" {
  mo2files -> deploy: error {class: deploy}
  deploy -> mo2files: "put back what changed" {class: deploy}
  deploy -> toolbox: "failure, reported. Nothing written" {class: deploy}
}
