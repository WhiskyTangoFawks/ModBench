# Query the record index, purple. A question and its answer are two arrows. A query reads the Store
# and never a file, so it answers from the last projection. index-load-order is what writes it.
# Governed by ADR-0009, ADR-0010, ADR-0015 and ADR-0019. Contract: query-index.md.
...@../styles
shape: sequence_diagram
views: "Plugins · Editor" {class: driving}
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
queries: @../target-architecture.medit_core.queries
queries.label: Queries
store: @../target-architecture.medit_driven.index.store
store.label: Store

views -> client: question {class: query}
client -> http: question {class: query}
http -> queries: question {class: query}
store -> queries: rows {class: query}
queries -> http: "answer: diff nodes, rows" {class: query}
http -> client: answer {class: query}
client -> views: records, cells, plugin-keyed status {class: query}
