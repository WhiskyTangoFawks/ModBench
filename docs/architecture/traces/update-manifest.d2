# Update manifest, green: each mod's manifest from the mod as it is.
...@../styles
shape: sequence_diagram
driving: "Mods · Source Control · Toolbox" {class: driving}
sourcecommands: @../target-architecture.modbench_core.sourcecommands
sourcecommands.label: source commands
instance: @../target-architecture.modbench_data.instance
instance.label: "Instance\nmods · downloaded files · the repository"
client: @../target-architecture.modbench_repositories.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
engine: @../target-architecture.medit_core.commands.engine
engine.label: Build engine
modfolder: @../target-architecture.medit_data.modfolder
modfolder.label: "Mod folders\nfiles · manifests · the stat cache"
modfolderadapter: @../target-architecture.medit_repositories.modfolderadapter
modfolderadapter.label: Mod folder adapter
port: @../target-architecture.medit_kernel.ports
port.label: Ports
instanceadapter: @../target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
instanceloader: @../target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
views: "every view" {class: driving}

driving -> sourcecommands: "update manifest: the mods, or every mod, with the instance value" {class: track}
instance -> instanceadapter: "each downloaded file: bytes, when its index is stale" {class: track}
instanceadapter -> sourcecommands: "each installation file: hash and entries · each game file a mod file overrides: hash" {class: track}
sourcecommands -> client: "update manifest: each mod's folder and installation files with their hashes and entries, each game file a mod file overrides with its hash, the stat cache's folder" {class: track}
client -> http: envelope {class: track}
http -> engine: envelope {class: track}
modfolder -> modfolderadapter: "each mod's files: bytes, or the stat cache's hash when its stamp matches" {class: track}
modfolderadapter -> engine: "hashed files" {class: track}
engine."per mod: each file matched to its provider, or none; refused when an installation file is missing; a source mod's manifest is its build's"
engine -> port: "progress, per mod" {class: push}
client -> http: "cancel: the gesture, after its first progress" {class: track}
http -> engine: "stop after the mod in hand" {class: track}
engine -> modfolderadapter: "each manifest that changed · the stat cache" {class: track}
modfolderadapter -> modfolder: "manifests · the stat cache" {class: track}
engine -> http: "landed or refused, per mod, and each file with no provider" {class: track}
http -> client: "landed or refused, per mod" {class: track}
client -> sourcecommands: the outcome {class: track}
sourcecommands -> driving: "the outcome" {class: track}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
