# Restore modlist, orange: each mod's folder from its manifest and the downloaded files it names.
...@../styles
shape: sequence_diagram
driving: "Toolbox · Mods" {class: driving}
commands: @../target-architecture.modbench_core.sourcecommands
commands.label: source commands
modsourceadapter: @../target-architecture.modbench_repositories.modsourceadapter
modsourceadapter.label: Mod source adapter
source: @../target-architecture.modbench_repositories.modlistsource
source.label: Modlist source
instance: @../target-architecture.modbench_data.instance
instance.label: "Instance\nmods · downloaded files · the build folder"
gamedata: @../target-architecture.modbench_data.gamedata
gamedata.label: Game folder
instanceadapter: @../target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
instanceloader: @../target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
views: "every view" {class: driving}

driving."the confirmation"
driving -> commands: "restore: the mods, or every mod, with the instance value" {class: compile}
commands -> source: "the mods" {class: compile}
instance -> source: "each manifest · commandsation files and deltas: bytes" {class: compile}
gamedata -> source: "game files: bytes" {class: compile}
source -> commands: "per mod: each file's bytes, or what the mod lacks" {class: compile}
commands."a mod that lacks anything is skipped; the rest are written"

tracked: "a tracked mod with a remote" {
  commands -> modsourceadapter: "the remote and the commit: clone when absent" {class: compile}
  commands."build-mod, at the manifest's commit; skipped and named when the source is at another commit"
}
commands -> instanceadapter: "each mod's files, whole · the mod folders with no manifest, to the trash" {class: compile}
instanceadapter -> instance: "the folders" {class: compile}
commands -> driving: "landed, with each skipped mod and what it lacks" {class: compile}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
