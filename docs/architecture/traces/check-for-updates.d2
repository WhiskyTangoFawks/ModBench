# Check for updates.
...@../styles
shape: sequence_diagram
mods: "Mods · Toolbox" {class: driving}
modcommands: @../target-architecture.modbench_core.modcommands
modcommands.label: mod commands
instanceadapter: @../target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
instance: @../target-architecture.modbench_data.instance
instance.label: "Instance\nthe mod's folder and meta"
nexus: @../target-architecture.modbench_repositories.nexus
nexus.label: Nexus
nexushost: @../target-architecture.modbench_data.nexus
nexushost.label: "Nexus\nthe mods and files it hosts"
instanceloader: @../target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader

mods -> modcommands: "the mods, or every mod" {class: track}
each mod: "each mod, on its own" {
  modcommands -> instanceadapter: "the mod's Nexus mod ID and installed file" {class: track}
  instance -> instanceadapter: "the mod's meta" {class: track}
  instanceadapter -> modcommands: "the mod's Nexus mod ID and installed file" {class: track}
  modcommands -> nexus: "the mod and its installed file" {class: track}
  nexus -> nexushost: "the mod's files and their updates" {class: track}
  nexushost -> nexus: "the mod's files and their updates" {class: track}
  nexus -> modcommands: "the newest version" {class: track}
  modcommands -> instanceadapter: "the newest version" {class: track}
  instanceadapter -> instance: "the mod's meta" {class: track}
}
modcommands -> mods: "each mod checked or refused" {class: track}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> mods: value {class: track}
instanceloader."the Update available mark follows the next snapshot"

logged out: "logged out, or a mod with no Nexus mod ID" {
  modcommands -> mods: "the refusal" {class: track}
}
