# Projection, purple. The load order snapshot arrives from Modbench; the Projector asks
# the kernel for winners and schema and decides nothing; the Store announces what changed
# and every subscriber re-reads.
...@../styles
shape: sequence_diagram
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance
toolbox: @../target-architecture.modbench_driving.toolbox
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
loadorder: @../target-architecture.medit_kernel.loadorder
loadorder.label: Load order state
projector: @../target-architecture.medit_driven.index.projector
projector.label: Projector
codec: @../target-architecture.medit_kernel.codec
codec.label: Codec + schema
sourcerepo: @../target-architecture.medit_driven.sourcerepo
sourcerepo.label: Source repository
pluginadapter: @../target-architecture.medit_driven.pluginadapter
pluginadapter.label: Plugin adapter
store: @../target-architecture.medit_driven.index.store
store.label: Store
port: @../target-architecture.medit_kernel.ports
port.label: Ports
views: "Plugins · Editor" {class: driving}

instance -> toolbox: load order snapshot {class: loadorder}
toolbox -> client: load order snapshot {class: loadorder}
client -> http: load order snapshot {class: loadorder}
http -> commands: put load order {class: loadorder}
commands -> loadorder: load order snapshot {class: query}
http -> projector: "reconcile: validate by hash" {class: signal}
loadorder -> projector: winners {class: query}
codec -> projector: schema {class: query}
sourcerepo -> projector: documents (tracked) {class: query}
pluginadapter -> projector: bytes (untracked) {class: query}
projector -> store: rows {class: query}
store -> port: "rows changed: keys, sequence" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> views: rows changed (push), then re-read {class: push}
