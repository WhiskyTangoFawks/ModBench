# One instance file updated. Fifteen commands draw this shape, so the two actors that differ are
# declared here as sets and the contract's table says which command uses which. A command
# splices through the pure codec and puts through the Instance adapter; the write is forgotten and the
# watch closes the loop, so a change from MO2 takes the same path. A system command is handed
# the instance value as an argument and reads nothing itself. An uninstall also marks the downloaded
# file it came from, for MO2's sake. Only plugins commands ask mEdit
# which plugins load with no line. The tail, indexing the new load order, is index-load-order's.
# Governed by ADR-0003, ADR-0013, ADR-0015, ADR-0016 and ADR-0017. Contract: update-load-order-file.md.
...@../styles
shape: sequence_diagram
surfaces: "Mods · Plugins · Toolbox · Downloads" {class: driving}
cmds: "modlist · plugins · instance · downloads commands" {class: core}
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance loader
client: @../target-architecture.modbench_core.client
client.label: mEdit client
codecs: @../target-architecture.modbench_kernel.codecs
codecs.label: MO2 file codecs
mo2files: @../target-architecture.modbench_driven.mo2files
mo2files.label: Instance adapter
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nmodlist.txt · plugins.txt · ModOrganizer.ini · mods/ · downloads/"
views: "every view" {class: driving}
toolbox: @../target-architecture.modbench_driving.toolbox
toolbox.label: Toolbox

surfaces -> cmds: "the gesture, with its argument" {class: loadorder}
instance -> cmds: "a system command: the value as an argument" {class: loadorder}
cmds -> client: "which plugins load with no line?" {class: query}
client -> cmds: the set, or unreachable {class: query}
cmds -> codecs: "the lines to flip, move, add or drop" {class: loadorder}
codecs -> cmds: bytes {class: loadorder}
cmds -> mo2files: "put the file · the folder to make, rename or remove" {class: loadorder}
uninstall: "an uninstall, from a downloaded file" {
  cmds -> codecs: "the download's .meta: uninstalled" {class: loadorder}
  codecs -> cmds: bytes {class: loadorder}
  cmds -> mo2files: "put the .meta in downloads/" {class: loadorder}
  cmds."a failed mark is a line in the Output, and the uninstall still applied"
}
mo2files -> mo2: bytes, then forget {class: loadorder}
cmds -> surfaces: "applied or refusal, per item" {class: loadorder}
mo2 -> instance: watch {class: signal}
instance."recompute whole, next sequence"
instance -> views: value {class: loadorder}
instance -> toolbox: "load order snapshot, on change and on connect" {class: loadorder}
toolbox."the rest is index-load-order"

refused: "refused, before any write" {
  cmds -> surfaces: "the object has gone · the target is not a valid place · mEdit cannot answer" {class: loadorder}
}
