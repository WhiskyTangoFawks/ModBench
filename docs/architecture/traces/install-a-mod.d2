# Loadout gesture. Install drops a folder; the Instance's watcher registers it, and the
# modlist adoption is a command handed the value, the way the plugins reconcile is. mEdit
# learns of the folder the same way: by watching.
...@../styles
shape: sequence_diagram
downloads: @../target-architecture.modbench_driving.downloads
downloads.label: Downloads
install: @../target-architecture.modbench_core.install
install.label: install
codecs: @../target-architecture.modbench_kernel.codecs
codecs.label: MO2 file codecs
mo2files: @../target-architecture.modbench_driven.mo2files
mo2files.label: MO2 files
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nmods/<name>/, meta.ini, modlist.txt"
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance
views: "every view" {class: driving}
modlist: @../target-architecture.modbench_core.modlist
modlist.label: modlist commands
watcher: @../target-architecture.medit_driving.watcher
watcher.label: "Mod watcher\nmEdit's own, one per mod"
projector: @../target-architecture.medit_driven.index.projector
projector.label: Projector

downloads -> install: install this {class: loadout}
install -> codecs: "meta.ini: the meta it knows" {class: loadout}
codecs -> install: bytes {class: loadout}
install -> mo2files: "stage, then one rename into mods/" {class: loadout}
mo2files -> mo2: the folder, then forget {class: loadout}
mo2 -> instance: watch {class: signal}
instance -> views: value {class: loadout}
instance -> modlist: "each value, as an argument: folders with no modlist line" {class: loadout}
modlist -> codecs: "modlist.txt: lines to add" {class: loadout}
codecs -> modlist: bytes {class: loadout}
modlist -> mo2files: "put modlist.txt" {class: loadout}
mo2files -> mo2: bytes, then forget {class: loadout}
mo2 -> watcher: bytes {class: signal}
watcher -> projector: plugin changed {class: signal}
