# Load order gesture. Install drops a folder; the Instance's watcher registers it, and the
# modlist adoption is a command handed the value, the way the plugins reconcile is. Nothing
# watches mods/ on the mEdit side, so mEdit learns of the new plugin the way it learns of
# every other load-order change: the adopted line makes a new snapshot and the tail of this
# trace is enable-a-mod's.
...@../styles
shape: sequence_diagram
downloads: @../target-architecture.modbench_driving.downloads
downloads.label: Downloads
install: @../target-architecture.modbench_core.install
install.label: install
codecs: @../target-architecture.modbench_kernel.codecs
codecs.label: MO2 file codecs
mo2files: @../target-architecture.modbench_driven.mo2files
mo2files.label: MO2 files
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nmods/<name>/, meta.ini, modlist.txt"
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance
views: "every view" {class: driving}
modlist: @../target-architecture.modbench_core.modlist
modlist.label: modlist commands
toolbox: @../target-architecture.modbench_driving.toolbox
toolbox.label: Toolbox
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands

downloads -> install: install this {class: loadorder}
install -> codecs: "meta.ini: the meta it knows" {class: loadorder}
codecs -> install: bytes {class: loadorder}
install -> mo2files: "stage, then one rename into mods/" {class: loadorder}
mo2files -> mo2: the folder, then forget {class: loadorder}
mo2 -> instance: watch {class: signal}
instance -> views: value {class: loadorder}
instance -> modlist: "each value, as an argument: folders with no modlist line" {class: loadorder}
modlist -> codecs: "modlist.txt: lines to add" {class: loadorder}
codecs -> modlist: bytes {class: loadorder}
modlist -> mo2files: "put modlist.txt" {class: loadorder}
mo2files -> mo2: bytes, then forget {class: loadorder}
mo2 -> instance: "watch: the adopted line" {class: signal}
instance -> toolbox: "load order snapshot, on change" {class: loadorder}
toolbox -> client: "load order snapshot" {class: loadorder}
client -> http: load order snapshot {class: loadorder}
http -> commands: put load order {class: loadorder}
