# External change, per mod. One watcher per mod; the Source repository names its paths.
# A tracked mod changed externally when the plugin bytes differ from the baseline, or a
# file git tracks differs from what git last saw; the preset chosen at Track decides what
# git tracks. meta.ini is a tell: its version chooses the default, never triggers. The
# human always answers. After the baseline commit the rebase is attempted at once.
...@../styles
shape: sequence_diagram
tools: @../target-architecture.medit_data.tools
tools.label: "Other tools, or a Modbench upgrade\nMO2, xEdit, the user, install"
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nthe tracked mod's folder: plugin · assets · meta.ini · source/ · .git"
watcher: @../target-architecture.medit_driving.watcher
watcher.label: "Mod watcher\nsettle per mod"
projector: @../target-architecture.medit_driven.index.projector
projector.label: Projector
commands: @../target-architecture.medit_core.commands
commands.label: Commands
port: @../target-architecture.medit_kernel.ports
port.label: Ports
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
client: @../target-architecture.modbench_core.client
client.label: mEdit client
plugins: @../target-architecture.modbench_driving.plugins
plugins.label: Plugins
sourcerepo: @../target-architecture.medit_driven.sourcerepo
sourcerepo.label: Source repository

tools -> mo2: bytes, at any time {class: outside}
mo2 -> watcher: changed paths {class: signal}
watcher -> projector: plugin or source changed {class: signal}
watcher -> commands: a tracked mod settled {class: signal}
commands."classify: plugin bytes vs baseline · git status of tracked files · meta hash as tell"
commands -> port: "external change pending: mod, what changed, default" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> plugins: external change pending {class: push}
plugins."one dialog per mod: Commit to main as new baseline · Apply to working tree on <branch> · Esc"
plugins -> client: baseline · apply {class: edit}
client -> http: envelope {class: edit}
http -> commands: envelope {class: edit}
commands -> sourcerepo: "baseline: documents and tracked files to main, deletions included" {class: track}
commands -> sourcerepo: "apply: working-tree dirt on the current branch, refusing a same-file collision" {class: edit}
sourcerepo."commit to main by plumbing, then rebase the edit branch"
sourcerepo -> commands: "rebase: clean · refused (paths) · conflicted (files)" {class: edit}
commands -> http: applied or refusal {class: edit}
http -> client: applied or refusal {class: edit}
client -> plugins: the outcome {class: edit}
plugins."clean: silent · refused: the paths · conflict: the merge editor"
