# Clean modlist, green: untracked files and mod folders with no manifest, to the trash, after the listing.
...@../styles
shape: sequence_diagram
driving: "Toolbox · Mods · Source Control" {class: driving}
sourcecommands: @../target-architecture.modbench_core.sourcecommands
sourcecommands.label: source commands
instanceadapter: @../target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
instance: @../target-architecture.modbench_data.instance
instance.label: "Instance\nmods · downloaded files · the repository"
instanceloader: @../target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
views: "every view" {class: driving}

driving -> sourcecommands: "clean: the mods, or every mod, with the instance value" {class: track}
sourcecommands."the listing: each file no manifest names, each mod folder with no manifest"
sourcecommands -> driving: "the listing" {class: track}
driving."the confirmation"
driving -> sourcecommands: "confirmed" {class: track}
sourcecommands -> instanceadapter: "the files and folders, to the trash" {class: track}
instanceadapter -> instance: "the trash" {class: track}
sourcecommands -> driving: "landed" {class: track}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
