# Index the load order, purple. The whole load order arrives from Modbench. For each copy the
# Indexer reads the mod's source when it is tracked and the plugin's bytes when it is not, asks
# the kernel which copy wins and what the schema is, and writes rows into the record index. It
# decides nothing itself. The Store then announces which keys changed, and every subscriber
# re-reads: that tail is the same one edit-record ends with.
# Governed by ADR-0009, ADR-0012, ADR-0013 and ADR-0015. Contract: index-load-order.md.
...@../styles
shape: sequence_diagram
instanceloader: @../target-architecture.modbench_driven.instanceloader
instanceloader.label: Instance loader
instancecommands: @../target-architecture.modbench_core.instancecommands
instancecommands.label: instance commands
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
loadorder: @../target-architecture.medit_kernel.loadorder
loadorder.label: Load order state
indexer: @../target-architecture.medit_driven.index.indexer
indexer.label: Indexer
codec: @../target-architecture.medit_kernel.codec
codec.label: Codec + schema
sourcerepo: @../target-architecture.medit_driven.sourcerepo
sourcerepo.label: Source adapter
pluginadapter: @../target-architecture.medit_driven.pluginadapter
pluginadapter.label: Plugin adapter
store: @../target-architecture.medit_driven.index.store
store.label: Store
port: @../target-architecture.medit_kernel.ports
port.label: Ports
views: "Plugins · Editor" {class: driving}

instanceloader -> instancecommands: "put load order: the snapshot as an argument" {class: loadorder}
instancecommands -> client: load order snapshot {class: loadorder}
client -> http: load order snapshot {class: loadorder}
http -> commands: put load order {class: loadorder}
commands -> loadorder: load order snapshot {class: query}
http -> indexer: "reconcile: validate by hash" {class: signal}
loadorder -> indexer: winners {class: query}
codec -> indexer: schema {class: query}
sourcerepo -> indexer: documents (tracked) {class: query}
pluginadapter -> indexer: bytes (untracked) {class: query}
indexer -> store: rows {class: query}
store -> port: "rows changed: keys, sequence" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> views: rows changed (push), then re-read {class: push}
