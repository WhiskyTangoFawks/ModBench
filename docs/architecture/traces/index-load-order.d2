# Index the load order.
...@../styles
shape: sequence_diagram
instanceloader: @../target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
instancecommands: @../target-architecture.modbench_core.instancecommands
instancecommands.label: instance commands
client: @../target-architecture.modbench_repositories.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
loadorder: @../target-architecture.medit_kernel.loadorder
loadorder.label: Load order state
indexer: @../target-architecture.medit_readmodel.index.indexer
indexer.label: Indexer
codec: @../target-architecture.medit_kernel.codec
codec.label: Codec + schema
sourceadapter: @../target-architecture.medit_repositories.sourceadapter
sourceadapter.label: Source adapter
pluginadapter: @../target-architecture.medit_repositories.pluginadapter
pluginadapter.label: Plugin adapter
store: @../target-architecture.medit_readmodel.index.store
store.label: Store
port: @../target-architecture.medit_kernel.ports
port.label: Ports
views: "Plugins · Editor" {class: driving}

instanceloader -> instancecommands: "put load order: the snapshot" {class: loadorder}
instancecommands -> client: "snapshot: the game release · every plugin and what provides it · the active plugins" {class: loadorder}
client -> http: "snapshot: the game release · every plugin and what provides it · the active plugins" {class: loadorder}
http -> commands: put load order {class: loadorder}
commands -> loadorder: snapshot {class: loadorder}
commands -> http: "applied: the version" {class: loadorder}
http -> client: the version {class: loadorder}
loadorder -> indexer: "a snapshot arrived" {class: signal}
indexer."validate every plugin"
codec -> indexer: schema {class: query}
sourceadapter -> indexer: documents (tracked) {class: query}
pluginadapter -> indexer: bytes (untracked) {class: query}
indexer -> store: rows {class: query}
loadorder -> indexer: the active plugins {class: query}
indexer."winners and conflicts"
indexer -> port: "index status: reconciling · ready · held elsewhere · failed" {class: push}
store -> port: "rows changed: keys, sequence" {class: push}
indexer -> port: "plugin changed: the plugin, sequence" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> views: "index status · rows changed · plugin changed" {class: push}
