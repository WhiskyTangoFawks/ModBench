# Loadout gesture, and the plugins reconcile. Enable and reorder splice plugins.txt.
# The reconcile is the same splice with another trigger: an Instance value in which mods/
# and plugins.txt disagree, handed to the command as an argument; the command reads
# nothing. Implicit masters come from mEdit (#810).
...@../styles
direction: down
plugins: "Plugins view" {class: driving}
instance: "Instance" {class: driven}
cmd: "plugins commands\nenable, reorder, reconcile against disk" {class: core}
client: "mEdit client" {class: core}
codec: "plugins.txt\nsplice" {class: core}
disk: "MO2 instance\nprofiles/<profile>/plugins.txt · mods/" {class: sor}
views: "every view" {class: driving}
medit: "mEdit\nload order state" {class: driving}

plugins -> cmd: gesture {class: loadout}
instance -> cmd: "each value, as an argument:\nplugins on disk not in plugins.txt, or gone" {class: loadout}
cmd -> client: which plugins load implicitly? {class: query}
client -> cmd: the set, or unreachable {class: query}
cmd -> codec: lines to flip, move, add or drop {class: loadout}
codec -> disk: bytes, then forget {class: loadout}
disk -> instance: watch {class: signal}
instance -> views: value {class: loadout}
instance -> client: load order snapshot {class: loadout}
client -> medit: load order snapshot {class: loadout}
