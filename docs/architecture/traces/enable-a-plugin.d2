# Load order gesture, and the plugins reconcile. Enable and reorder splice plugins.txt. The
# reconcile is the same splice with another trigger: an Instance value in which mods/ and
# plugins.txt disagree, handed to the command as an argument; the command reads nothing.
# Implicit masters come from mEdit.
...@../styles
shape: sequence_diagram
plugins: @../target-architecture.modbench_driving.plugins
plugins.label: Plugins
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance
pluginscommands: @../target-architecture.modbench_core.pluginscommands
pluginscommands.label: plugins commands
toolbox: @../target-architecture.modbench_driving.toolbox
client: @../target-architecture.modbench_core.client
client.label: mEdit client
codecs: @../target-architecture.modbench_kernel.codecs
codecs.label: MO2 file codecs
mo2files: @../target-architecture.modbench_driven.mo2files
mo2files.label: MO2 files
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nprofiles/<profile>/plugins.txt · mods/"
views: "every view" {class: driving}
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
loadorder: @../target-architecture.medit_kernel.loadorder
loadorder.label: "Load order state\nmEdit"

plugins -> pluginscommands: enable · reorder {class: loadorder}
instance -> pluginscommands: "each value, as an argument: plugins on disk not in plugins.txt, or gone" {class: loadorder}
pluginscommands -> client: which plugins load implicitly? {class: query}
client -> pluginscommands: the set, or unreachable {class: query}
pluginscommands -> codecs: "plugins.txt: lines to flip, move, add or drop" {class: loadorder}
codecs -> pluginscommands: bytes {class: loadorder}
pluginscommands -> mo2files: "put plugins.txt" {class: loadorder}
mo2files -> mo2: bytes, then forget {class: loadorder}
mo2 -> instance: watch {class: signal}
instance -> views: value {class: loadorder}
instance -> toolbox: load order snapshot {class: loadorder}
toolbox -> client: load order snapshot {class: loadorder}
client -> http: load order snapshot {class: loadorder}
http -> commands: put load order {class: loadorder}
commands -> loadorder: load order snapshot {class: loadorder}
