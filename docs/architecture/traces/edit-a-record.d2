# Edit gesture, both processes. Blue carries the edit down to the source tree;
# purple carries the projection back up. The editor re-reads on the push.
...@../styles
direction: down
editor: "Editor" {class: driving}
client: "mEdit client" {class: core}
http: "HTTP endpoints\nand the notification stream" {class: driving}
cmd: "Commands\nrecord: edit" {class: core}
srcrepo: "Source repository" {class: driven}
source: "Source tree in git" {class: sor}
watcher: "Mod watcher" {class: driving}
proj: "Projector\nrefresh keys" {class: driven}
store: "Store" {class: derived}
port: "Notification port" {class: core}

editor -> client: "edit: one path" {class: edit}
client -> http: envelope {class: edit}
http -> cmd: envelope {class: edit}
source -> srcrepo: documents {class: edit}
srcrepo -> cmd: current document {class: edit}
cmd -> srcrepo: new document {class: edit}
srcrepo -> source: documents {class: edit}
cmd -> http: applied or refusal {class: signal}
http -> client: applied or refusal {class: signal}
client -> editor: applied or refusal {class: signal}
source -> watcher: source changed {class: signal}
watcher -> proj: source changed {class: signal}
srcrepo -> proj: documents (tracked) {class: query}
proj -> store: rows {class: query}
store -> port: rows changed: keys, sequence {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> editor: rows changed (push), then re-read {class: push}
