# Loadout gesture, Modbench only. The command writes and forgets; the watch closes the
# loop, so this is the same path a change from MO2 takes.
...@../styles
shape: sequence_diagram
mods: @../target-architecture.modbench_driving.mods
mods.label: Mods
modlist: @../target-architecture.modbench_core.modlist
modlist.label: modlist commands
codecs: @../target-architecture.modbench_kernel.codecs
codecs.label: MO2 file codecs
mo2files: @../target-architecture.modbench_driven.mo2files
mo2files.label: MO2 files
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nprofiles/<profile>/modlist.txt"
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance
views: "every view" {class: driving}
client: @../target-architecture.modbench_core.client
client.label: mEdit client
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands
commands.label: Commands
loadorder: @../target-architecture.medit_kernel.loadorder
loadorder.label: "Load order state\nmEdit"

mods -> modlist: enable {class: loadout}
modlist -> codecs: "modlist.txt: line to flip" {class: loadout}
codecs -> modlist: bytes {class: loadout}
modlist -> mo2files: "put modlist.txt" {class: loadout}
mo2files -> mo2: bytes, then forget {class: loadout}
mo2 -> instance: watch {class: signal}
instance."recompute, next sequence"
instance -> views: value {class: loadout}
instance -> client: "load order snapshot, on change and on connect" {class: loadout}
client -> http: load order snapshot {class: loadout}
http -> commands: put load order {class: loadout}
commands -> loadorder: load order snapshot {class: loadout}
