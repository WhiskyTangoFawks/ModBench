# Install, both targets.
...@../styles
shape: sequence_diagram
downloads: "Downloads · Mods" {class: driving}
instanceloader: @../target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
modordercommands: @../target-architecture.modbench_core.modordercommands
modordercommands.label: mod commands
client: @../target-architecture.modbench_repositories.client
client.label: mEdit client
instanceadapter: @../target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
instance: @../target-architecture.modbench_data.instance
instance.label: "Instance\nthe mod's folder and meta · the downloaded file's metadata"
views: "every view" {class: driving}

instanceloader -> downloads: "value: mods with this Nexus id, their installed files" {class: loadorder}
downloads."the target pick"
downloads -> modordercommands: "the source, and the target" {class: loadorder}
upgrade: "an upgrade" {
  modordercommands -> client: "the mod's status" {class: query}
  client -> modordercommands: "the mod's status: differs, no manifest, a file with no provider, or none" {class: query}
  modordercommands."refused on any of the three, unless the target pick forces it"
}
modordercommands -> instanceadapter: "install: the source, the target, the mod's metadata" {class: loadorder}
instanceadapter."a new folder, or the release into the mod's own; the root chosen inside"
from download: "from a downloaded file" {
  modordercommands -> instanceadapter: "the downloaded file: installed" {class: loadorder}
}
instanceadapter -> instance: "the folder · the metadata" {class: loadorder}
modordercommands -> downloads: applied or refusal {class: loadorder}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
instanceloader."mod sync: update-load-order-file"
instanceloader."the next snapshot: index-load-order; in a source mod, detect-external-change"

refused: "refused, before any write" {
  modordercommands -> downloads: "the refusal" {class: loadorder}
}
