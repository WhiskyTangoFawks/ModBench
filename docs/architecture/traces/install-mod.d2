# Install, both targets. Contract: install-mod.md.
...@../styles
shape: sequence_diagram
downloads: @../target-architecture.modbench_driving.downloads
downloads.label: "Downloads · Mods"
instanceloader: @../target-architecture.modbench_driven.instanceloader
instanceloader.label: Instance loader
install: @../target-architecture.modbench_core.install
install.label: install
codecs: @../target-architecture.modbench_kernel.codecs
codecs.label: MO2 file codecs
instanceadapter: @../target-architecture.modbench_driven.instanceadapter
instanceadapter.label: Instance adapter
mo2: @../target-architecture.modbench_data.mo2
mo2.label: "MO2 instance\nmods/<name>/, meta.ini · downloads/<file>.meta"
views: "every view" {class: driving}
watcher: @../target-architecture.medit_driving.watcher
watcher.label: "Mod watcher\nmEdit"

instanceloader -> downloads: "value: mods with this Nexus id, their installed files" {class: loadorder}
downloads."the target: a new mod, or a candidate pre-selected by file id, else by its recorded installation file. Always confirmed. Esc installs nothing"
downloads -> install: "the source, and the target" {class: loadorder}
install -> codecs: "meta.ini: the meta it knows" {class: loadorder}
codecs -> install: bytes {class: loadorder}

new mod: "a new mod" {
  install -> instanceadapter: "stage, meta.ini first, then one rename into mods/" {class: loadorder}
}
upgrade: "an upgrade" {
  install -> instanceadapter: "staged tree in, old files out, .git kept" {class: loadorder}
}

from download: "from a downloaded file" {
  install -> codecs: "the .meta: installed" {class: loadorder}
  codecs -> install: bytes {class: loadorder}
  install -> instanceadapter: "put the .meta in downloads/" {class: loadorder}
  install."a failed mark is a line in the Output, and the install still applied"
}

instanceadapter -> mo2: "the folder, the .meta, then forget" {class: loadorder}
install -> downloads: applied or refusal {class: loadorder}
mo2 -> instanceloader: watch {class: signal}
instanceloader -> views: value {class: loadorder}
instanceloader."the folder has no line: update-load-order-file adopts it"
mo2 -> watcher: changed paths {class: signal}
watcher."a tracked mod: decompile-plugin from here, the new baseline as the default"

refused: "refused, before any write" {
  install -> downloads: "a new mod whose folder exists · an upgrade whose folder has gone · mods/ on another volume · the archive cannot be extracted" {class: loadorder}
}
