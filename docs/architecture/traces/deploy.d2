# Deploy. Deploy and purge are commands that take one Instance value, with its sequence, as
# an argument and write Game Data/ through MO2 files; the manifest is Game Data's hash and an
# Instance input, so deploy state comes back the same way as everything else.
...@../styles
shape: sequence_diagram
instance: @../target-architecture.modbench_driven.instance
instance.label: Instance
toolbox: @../target-architecture.modbench_driving.toolbox
toolbox.label: Toolbox
deploy: @../target-architecture.modbench_core.deploy
deploy.label: deploy commands
tables: @../target-architecture.modbench_kernel.tables
tables.label: per-release tables
mo2files: @../target-architecture.modbench_driven.mo2files
mo2files.label: MO2 files
gamedata: @../target-architecture.modbench_data.gamedata
gamedata.label: Game Data/

instance -> toolbox: one value, with its sequence {class: loadout}
toolbox."the first-deploy consent"
toolbox -> deploy: "deploy · purge, with the value" {class: deploy}
tables -> deploy: load-order file destination {class: deploy}
deploy -> mo2files: "the hardlinks to make · the manifest" {class: deploy}
mo2files -> gamedata: hardlinks · manifest, then forget {class: deploy}
gamedata -> instance: "watch: the manifest" {class: signal}
instance -> toolbox: value, deploy state {class: loadout}
