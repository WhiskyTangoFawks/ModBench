# A script's write reaches its next query and every view, blue.
...@../styles
shape: sequence_diagram
scripts: @../target-architecture.medit_drivers.scripts
scripts.label: Scripts
http: @../target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../target-architecture.medit_core.commands.edits
commands.label: Record edits
sourceadapter: @../target-architecture.medit_repositories.sourceadapter
sourceadapter.label: Source adapter
source: @../target-architecture.medit_data.source
indexer: @../target-architecture.medit_readmodel.index.indexer
indexer.label: Indexer
queries: @../target-architecture.medit_readmodel.index.queries
queries.label: Queries
store: @../target-architecture.medit_readmodel.index.store
store.label: Store
port: @../target-architecture.medit_kernel.ports
port.label: Ports
client: @../target-architecture.modbench_repositories.client
client.label: mEdit client
views: "Plugins · Editor" {class: driving}

scripts -> http: "copy, create, edit or delete" {class: edit}
http -> commands: envelope {class: edit}
commands."the changes: script-edit"
commands -> sourceadapter: write {class: signal}
sourceadapter -> source: "moves, then deletions, then documents" {class: edit}
sourceadapter -> indexer: "the paths it wrote, whether they held or were put back" {class: signal}
sourceadapter -> commands: written {class: edit}
commands -> http: applied {class: edit}
http -> scripts: "204, or the FormKey the copy or the new record holds" {class: edit}
scripts -> http: "the next query: select, read, resolve or references" {class: query}
http -> queries: question {class: query}
queries."waits until every path written before it is validated"
indexer."validate the trees holding those paths, once a reconcile in flight ends"
sourceadapter -> indexer: documents {class: query}
indexer -> store: rows {class: query}
store -> port: "rows changed: keys, sequence" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> views: rows changed {class: push}
views."re-read: query-index"
store -> queries: rows {class: query}
queries -> http: answer {class: query}
http -> scripts: answer {class: query}
