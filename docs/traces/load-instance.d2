# Load the instance.
...@../../spec/architecture/styles
shape: sequence_diagram
instance: @../../spec/architecture/target-architecture.modbench_data.instance
instance.label: "Instance\nthe mod manager's files · plugins.txt · mods · Overwrite · downloaded files · the sorting rule files"
instanceadapter: @../../spec/architecture/target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
instanceloader: @../../spec/architecture/target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
manifestadapter: @../../spec/architecture/target-architecture.modbench_repositories.manifestadapter
manifestadapter.label: Manifest adapter
views: "Toolbox · Mods · Plugins · Downloads" {class: driving}
activation: @../../spec/architecture/target-architecture.modbench_drivers.activation
activation.label: Activation
instancecommands: @../../spec/architecture/target-architecture.modbench_core.instancecommands
instancecommands.label: instance commands
client: @../../spec/architecture/target-architecture.modbench_repositories.client
client.label: mEdit client
toolbox: @../../spec/architecture/target-architecture.modbench_driving.toolbox
toolbox.label: Toolbox

instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> instanceadapter: "get: the instance's files" {class: loadorder}
instanceadapter -> instanceloader: "parsed: the game, the profile, the mods and their meta, the load order, the downloaded files, the game folder's plugins and Creation Club list, the sorting rule files, the source folder's repositories" {class: loadorder}
instanceloader -> manifestadapter: "get: the repository each mod folder's manifest names" {class: loadorder}
manifestadapter -> instanceloader: "the source mods: each repository by the mod it builds" {class: loadorder}
instanceloader."the value, replaced whole"
instanceloader -> views: "value · the last read's failure, if any" {class: loadorder}
instanceloader -> activation: value {class: loadorder}
activation -> instancecommands: "put load order: the snapshot" {class: loadorder}
instancecommands -> client: "snapshot: the game release · every plugin and what provides it · the active plugins · the strings language" {class: loadorder}

refresh: "refresh, from the Toolbox" {
  toolbox -> instancecommands: refresh {class: loadorder}
  instancecommands -> client: "rebuild the record index" {class: loadorder}
  client -> instancecommands: applied or refusal {class: loadorder}
  instancecommands."a refused rebuild stops here"
  instancecommands -> toolbox: applied or refusal {class: loadorder}
  toolbox -> instanceloader: refresh {class: loadorder}
}
