engine -> http: "the outcome, per mod" {class: track}
http -> client: "the outcome, per mod" {class: track}
client -> sourcecommands: the outcome {class: track}
sourcecommands -> instanceadapter: "each source mod with a remote: its submodule" {class: track}
instanceadapter -> instance: ".gitmodules · the ignore list" {class: track}
sourcecommands -> driving: "the outcome" {class: track}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
