# One instance file updated.
...@../../spec/architecture/styles
shape: sequence_diagram
surfaces: "Mods · Plugins · Toolbox · Downloads" {class: driving}
cmds: "mod · plugin · instance · downloaded file commands" {class: core}
instanceloader: @../../spec/architecture/target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
activation: @../../spec/architecture/target-architecture.modbench_drivers.activation
activation.label: Activation
instanceadapter: @../../spec/architecture/target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
client: @../../spec/architecture/target-architecture.modbench_repositories.client
client.label: mEdit client
instance: @../../spec/architecture/target-architecture.modbench_data.instance
instance.label: "Instance\nmod order · plugins.txt · the mod manager's configuration · mods · downloaded files"
views: "every view" {class: driving}

surfaces -> cmds: "the gesture: its Argument and Options" {class: loadorder}
instanceloader -> activation: value {class: loadorder}
activation -> cmds: "a system command" {class: signal}
cmds -> instanceadapter: "get: the files the change rests on" {class: loadorder}
instanceadapter -> cmds: "mod order · plugins.txt lines · folders" {class: loadorder}
cmds -> client: "for a move: their masters" {class: query}
client -> cmds: the masters {class: query}
cmds -> instanceadapter: "the change: lines, folders and file names" {class: loadorder}
uninstall: "an uninstall, from a downloaded file" {
  cmds -> instanceadapter: "the downloaded file's metadata: uninstalled" {class: loadorder}
}
instanceadapter -> instance: bytes {class: loadorder}
cmds -> surfaces: "applied or refusal, per item" {class: loadorder}
surfaces -> instanceloader: refresh {class: loadorder}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
instanceloader -> activation: value {class: loadorder}
activation -> cmds: "put load order: the snapshot" {class: loadorder}
cmds."the rest is index-load-order"

refused: "refused, before any write" {
  cmds -> surfaces: "the refusal" {class: loadorder}
}
