driving -> sourcecommands: "build: the mods" {class: compile}
sourcecommands -> textdocuments: "save: each mod's unsaved plugin source" {class: compile}
textdocuments -> sourcecommands: "saved, or the file VS Code did not save" {class: compile}
sourcecommands -> manifestadapter: "get: each mod's manifest" {class: compile}
instance -> manifestadapter: manifests {class: compile}
manifestadapter -> sourcecommands: "each mod's manifest" {class: compile}
sourcecommands -> instanceadapter: "get: each mod's folder · each package, hashed" {class: compile}
instance -> instanceadapter: "downloaded files" {class: compile}
instanceadapter -> sourcecommands: "each mod's folder · each package, hashed" {class: compile}
sourcecommands -> tasks: "get: each task's label" {class: outside}
tasks -> sourcecommands: "each task's label" {class: outside}
sourcecommands."refused when the output folder is not the mod's, or a tool has no task"
sourcecommands -> instanceadapter: "each file the manifest takes from a package" {class: compile}
instanceadapter -> instance: "the files" {class: compile}
sourcecommands -> client: "build: each mod's folder · the archives to pack and the files each takes" {class: compile}
client -> http: envelope {class: compile}
http -> engine: envelope {class: compile}
source -> sourceadapter: "each mod's source at its commit" {class: compile}
sourceadapter -> engine: "the source" {class: compile}
engine -> commands: "compile-plugin, per plugin" {class: compile}
engine -> modfolderadapter: "the assets · the archives" {class: compile}
modfolderadapter -> modfolder: "the folder" {class: compile}
engine -> http: "the files it made, per mod" {class: compile}
http -> client: "the files it made, per mod" {class: compile}
client -> sourcecommands: "the files it made, per mod" {class: compile}

withsteps: "a mod whose manifest holds steps" {
  sourcecommands -> tasks: "each step's task, with its arguments, in the mod's folder" {class: outside}
  tasks -> sourcecommands: "its exit code" {class: outside}
}

sourcecommands -> instanceadapter: "get: the files the build made, hashed, as its repository's entries" {class: compile}
instance -> instanceadapter: "each mod's files" {class: compile}
instanceadapter -> sourcecommands: "the files, hashed" {class: compile}
sourcecommands -> manifestadapter: "each mod's manifest" {class: compile}
manifestadapter -> instance: manifests {class: compile}
sourcecommands -> driving: "the outcome" {class: compile}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
