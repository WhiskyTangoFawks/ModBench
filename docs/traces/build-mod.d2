# Build, orange: a source mod's folder written from its source folder, then recorded in its manifest.
...@../../spec/architecture/styles
shape: sequence_diagram
driving: "Source · Editor" {class: driving}
sourcecommands: @../../spec/architecture/target-architecture.modbench_core.sourcecommands
sourcecommands.label: source commands
textdocuments: @../../spec/architecture/target-architecture.modbench_repositories.textdocuments
textdocuments.label: Text documents
manifestadapter: @../../spec/architecture/target-architecture.modbench_repositories.manifestadapter
manifestadapter.label: Manifest adapter
instance: @../../spec/architecture/target-architecture.modbench_data.instance
instance.label: "Instance\nmods · downloaded files · the hash index · the manifests · the build files"
instanceadapter: @../../spec/architecture/target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
tasks: "VS Code's tasks" {class: other}
client: @../../spec/architecture/target-architecture.modbench_repositories.client
client.label: mEdit client
http: @../../spec/architecture/target-architecture.medit_driving.http
http.label: HTTP endpoints
engine: @../../spec/architecture/target-architecture.medit_core.commands.engine
engine.label: Build engine
source: @../../spec/architecture/target-architecture.medit_data.source
source.label: Mod source
sourceadapter: @../../spec/architecture/target-architecture.medit_repositories.sourceadapter
sourceadapter.label: Source adapter
commands: @../../spec/architecture/target-architecture.medit_core.commands
commands.label: Commands
modfolderadapter: @../../spec/architecture/target-architecture.medit_repositories.modfolderadapter
modfolderadapter.label: Mod folder adapter
modfolder: @../../spec/architecture/target-architecture.medit_data.modfolder
modfolder.label: "Mod folders\nassets · archives"
instanceloader: @../../spec/architecture/target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
views: "every view" {class: driving}

driving -> sourcecommands: "build: the mods" {class: compile}
sourcecommands -> textdocuments: "save: each mod's unsaved plugin source" {class: compile}
textdocuments -> sourcecommands: "saved, or the file VS Code did not save" {class: compile}
sourcecommands -> manifestadapter: "get: each mod's build file · its manifest" {class: compile}
instance -> manifestadapter: "build files · manifests" {class: compile}
manifestadapter -> sourcecommands: "each mod's build file · its manifest, naming its repository" {class: compile}
sourcecommands -> instanceadapter: "get: each mod's folder" {class: compile}
instanceadapter -> sourcecommands: "each mod's folder" {class: compile}
sourcecommands -> tasks: "get: each task's label" {class: outside}
tasks -> sourcecommands: "each task's label" {class: outside}
sourcecommands."refused when a tool has no task"
sourcecommands -> driving: "confirm: each file I changed, and each file the build does not make" {class: compile}
driving -> sourcecommands: "yes" {class: compile}
builtin: "each built-in step, a decompile, compile, copy or pack, in build-file order" {
  sourcecommands -> client: "build: the mod's folder · its step" {class: compile}
  client -> http: envelope {class: compile}
  http -> engine: envelope {class: compile}
  source -> sourceadapter: "the source folder's files · plugin source" {class: compile}
  sourceadapter -> engine: "the files a copy names · the plugin source" {class: compile}
  engine -> commands: "compile-plugin, per plugin a compile names" {class: compile}
  engine -> sourceadapter: "the plugin source a decompile makes, once every plugin of it decompiled" {class: compile}
  sourceadapter -> engine: "each plugin source folder it moved aside, in this build or one before" {class: compile}
  engine -> modfolderadapter: "the files a copy writes · the archives a pack makes" {class: compile}
  modfolderadapter -> modfolder: "the folder" {class: compile}
  engine -> http: "the files it made · what it moved aside or packed" {class: compile}
  http -> client: "the files it made · what it moved aside or packed" {class: compile}
  client -> sourcecommands: "the files it made · what it moved aside or packed" {class: compile}
  sourcecommands -> instanceadapter: "trash: the plugin source moved aside · the loose files packed" {class: compile}
}

task: "each task step, in build-file order among the built-in steps" {
  sourcecommands -> tasks: "the step's task, with its arguments, in the mod's folder" {class: outside}
  tasks -> sourcecommands: "its exit code" {class: outside}
}

sourcecommands."a failed step stops the mod's build"

sourcecommands -> instanceadapter: "get: the files the build made, hashed" {class: compile}
instance -> instanceadapter: "each mod's files" {class: compile}
instanceadapter -> sourcecommands: "the files, hashed" {class: compile}
sourcecommands -> instanceadapter: "trash: each file the folder holds that the build did not make" {class: compile}
instanceadapter -> instance: "the trash" {class: compile}
sourcecommands -> manifestadapter: "each mod's manifest: its repository and each file the build made, with its hash" {class: compile}
manifestadapter -> instance: "the manifest, in the mod's folder" {class: compile}
sourcecommands -> driving: "the outcome" {class: compile}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
