instanceloader -> activation: value {class: loadorder}
activation -> instancecommands: "put load order: the snapshot, with each mod's metadata" {class: loadorder}
instancecommands -> client: snapshot {class: loadorder}
client -> http: snapshot {class: loadorder}
http -> commands: put load order {class: loadorder}
commands -> engine: "the snapshot's mods and metadata" {class: loadorder}
modfolder -> modfolderadapter: "manifests · each mod's files" {class: track}
modfolderadapter -> engine: "each mod's status" {class: track}
engine."only the mods that changed since the last push"
engine -> port: "mod status changed: the mods" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> mods: "mod status changed" {class: push}
mods -> client: "mod status: the mods" {class: query}
client -> http: envelope {class: query}
http -> engine: "mod status: the mods" {class: query}
engine -> http: "per mod: its status" {class: query}
http -> client: "per mod: its status" {class: query}
client -> mods: "per mod: its status" {class: query}
