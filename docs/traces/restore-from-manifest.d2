# Restore from manifest, orange: each mod's folder made what its manifest says; a source mod rebuilt from its submodule at the commit the modlist pins.
...@../../spec/architecture/styles
shape: sequence_diagram
driving: "Mods · Source Control · Toolbox" {class: driving}
sourcecommands: @../../spec/architecture/target-architecture.modbench_core.sourcecommands
sourcecommands.label: source commands
manifestadapter: @../../spec/architecture/target-architecture.modbench_repositories.manifestadapter
manifestadapter.label: Manifest adapter
instance: @../../spec/architecture/target-architecture.modbench_data.instance
instance.label: "Instance\nmods · downloaded files · the hash index · the manifests · submodules"
instanceadapter: @../../spec/architecture/target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
nexus: @../../spec/architecture/target-architecture.modbench_repositories.nexus
nexus.label: Nexus
nexushost: @../../spec/architecture/target-architecture.modbench_data.nexus
nexushost.label: "Nexus\nthe mods and files it hosts"
tasks: "VS Code's tasks" {class: other}
client: @../../spec/architecture/target-architecture.modbench_repositories.client
client.label: mEdit client
http: @../../spec/architecture/target-architecture.medit_driving.http
http.label: HTTP endpoints
commands: @../../spec/architecture/target-architecture.medit_core.commands
commands.label: Commands
source: @../../spec/architecture/target-architecture.medit_data.source
source.label: Mod source
sourceadapter: @../../spec/architecture/target-architecture.medit_repositories.sourceadapter
sourceadapter.label: Source adapter
instanceloader: @../../spec/architecture/target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader
views: "every view" {class: driving}

driving -> sourcecommands: "restore from manifest: the mods" {class: compile}
sourcecommands -> manifestadapter: "get: each mod's manifest" {class: compile}
instance -> manifestadapter: manifests {class: compile}
manifestadapter -> sourcecommands: "each mod's manifest" {class: compile}
sourcecommands -> instanceadapter: "get: each mod's files, hashed, and its metadata · each package, hashed · each submodule's pin" {class: compile}
instance -> instanceadapter: "each mod's files · metadata · downloaded files · submodules" {class: compile}
instanceadapter -> sourcecommands: "each mod's files, hashed, and its metadata · each package, hashed · each submodule's pin" {class: compile}
sourcecommands -> driving: "the listing: what restore destroys" {class: compile}
driving."the confirmation, when the listing holds anything"
driving -> sourcecommands: "confirmed" {class: compile}

download: "an installation file the downloads folder lacks, whose page on Nexus the manifest names" {
  sourcecommands -> nexus: "the file's page" {class: compile}
  nexushost -> nexus: "the file · what Nexus knows of it" {class: compile}
  nexus -> sourcecommands: "the file · what Nexus knows of it" {class: compile}
  sourcecommands -> instanceadapter: "the downloaded file · its metadata" {class: compile}
  instanceadapter -> instance: "the downloaded file · its metadata" {class: compile}
  instanceadapter -> sourcecommands: "the package, hashed" {class: compile}
}

sourcecommands -> tasks: "get: each task's label" {class: outside}
tasks -> sourcecommands: "each task's label" {class: outside}
sourcecommands -> instanceadapter: "each file whose bytes differ, from its package · each file no line names · each mod's metadata · the push check" {class: compile}
instanceadapter -> instance: "the files · the trash · metadata · the push check" {class: compile}

sourcemod: "a source mod with a remote" {
  sourcecommands -> client: "clone: the submodule and its pin" {class: compile}
  client -> http: envelope {class: compile}
  http -> commands: envelope {class: compile}
  source -> sourceadapter: "the commit at HEAD, or absent" {class: compile}
  sourceadapter -> commands: "the commit" {class: compile}
  commands -> sourceadapter: "the pin" {class: compile}
  sourceadapter -> source: "the clone, when absent · the followed branch, when at the pin" {class: compile}
  commands -> http: "cloned, or at another commit" {class: compile}
  http -> client: "cloned, or at another commit" {class: compile}
  client -> sourcecommands: "cloned, or at another commit" {class: compile}
  sourcecommands."build-mod, or skipped when the submodule is at another commit"
}

sourcecommands -> tasks: "each step's task, with its arguments, in the mod's folder" {class: outside}
tasks -> sourcecommands: "its exit code" {class: outside}
sourcecommands -> driving: "the outcome" {class: compile}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
