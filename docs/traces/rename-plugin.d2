# Rename a plugin, cyan and blue.
...@../../spec/architecture/styles
shape: sequence_diagram
plugins: @../../spec/architecture/target-architecture.modbench_driving.plugins
plugins.label: Plugins
plugincommands: @../../spec/architecture/target-architecture.modbench_core.plugincommands
plugincommands.label: plugin commands
client: @../../spec/architecture/target-architecture.modbench_repositories.client
client.label: mEdit client
instanceadapter: @../../spec/architecture/target-architecture.modbench_repositories.instanceadapter
instanceadapter.label: Instance adapter
instanceloader: @../../spec/architecture/target-architecture.modbench_readmodel.instanceloader
instanceloader.label: Instance loader

plugins."the name"
plugins -> plugincommands: "the gesture: the plugin, the new name" {class: loadorder}
plugincommands -> client: "the plugin's dependants" {class: query}
client -> plugincommands: "the dependants" {class: query}
plugincommands."confirm, when there are dependants"
plugincommands -> client: "rename source: the plugin, the new name; the rest is edit-record" {class: edit}
client -> plugincommands: applied or refusal {class: edit}
plugincommands -> instanceadapter: "the change: the file names · the lines, every profile; the rest is update-load-order-file" {class: loadorder}
plugincommands -> plugins: applied or refusal {class: loadorder}
plugins -> instanceloader: refresh {class: loadorder}

refused: "refused, before any write" {
  plugincommands -> plugins: "the refusal" {class: loadorder}
}
failed: "the files failed after the source" {
  plugincommands -> plugins: "the failure: the plugin" {class: loadorder}
}
