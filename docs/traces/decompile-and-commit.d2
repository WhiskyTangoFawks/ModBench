views: "every view" {class: driving}

driving -> sourcecommands: "decompile and commit: the mods" {class: track}
sourcecommands -> manifestadapter: "get: each mod's manifest" {class: track}
instance -> manifestadapter: manifests {class: track}
manifestadapter -> sourcecommands: "each mod's manifest, when it has one" {class: track}
sourcecommands -> instanceadapter: "get: each mod's folder, its files and package, hashed" {class: track}
instance -> instanceadapter: "each mod's files · downloaded files" {class: track}
instanceadapter -> sourcecommands: "each mod's folder · its files and package, hashed" {class: track}
sourcecommands -> client: "init: each mod's folder · its assets · its manifest, as bytes" {class: track}
client -> http: envelope {class: track}
http -> engine: envelope {class: track}
engine -> commands: "decompile-plugin, every plugin of the mod" {class: track}
modfolder -> modfolderadapter: "the assets" {class: track}
modfolderadapter -> engine: "the assets" {class: track}
engine -> sourceadapter: "the repository and its first commit: plugin source, assets, the manifest" {class: track}
sourceadapter -> source: "the source folder" {class: track}
engine -> http: "the outcome" {class: track}
http -> client: "the outcome" {class: track}
client -> sourcecommands: the outcome {class: track}
sourcecommands -> manifestadapter: "the mod folder's manifest, removed" {class: track}
manifestadapter -> instance: manifests {class: track}
sourcecommands -> driving: "the outcome" {class: track}
refused: "refused, before any write: nothing of the mod, and no repository" {
  engine -> http: "the refusal" {class: track}
}
instance -> instanceadapter: watch {class: signal}
instanceadapter -> instanceloader: "the instance changed" {class: signal}
instanceloader -> views: value {class: loadorder}
