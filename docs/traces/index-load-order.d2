views: "Plugins · Editor" {class: driving}

instanceloader -> activation: value {class: loadorder}
activation."on each value, and on a change to the strings language setting"
activation -> instancecommands: "put load order: the snapshot" {class: loadorder}
instancecommands -> client: "snapshot: the game release · every plugin and what provides it · the active plugins · the strings language" {class: loadorder}
client -> http: "snapshot: the game release · every plugin and what provides it · the active plugins · the strings language" {class: loadorder}
http -> commands: put load order {class: loadorder}
commands -> loadorder: snapshot {class: loadorder}
commands -> http: "applied: the version" {class: loadorder}
http -> client: the version {class: loadorder}
loadorder -> indexer: "a snapshot arrived" {class: signal}
indexer."validate every plugin"
codec -> indexer: schema {class: query}
sourceadapter -> indexer: documents (a compiled plugin) {class: query}
pluginadapter -> indexer: "bytes (no source, or plugin source unreadable)" {class: query}
indexer -> store: rows {class: query}
loadorder -> indexer: the active plugins {class: query}
indexer."winners and conflicts"
indexer -> port: "record index status: reconciling · ready · held elsewhere · failed" {class: push}
store -> port: "rows changed: keys, sequence" {class: push}
indexer -> port: "plugin changed: the plugin, sequence" {class: push}
indexer -> port: "record filter cleared: its source, the database's reason" {class: push}
port -> http: publish {class: push}
http -> client: stream {class: push}
client -> views: "record index status · rows changed · plugin changed · record filter cleared" {class: push}
