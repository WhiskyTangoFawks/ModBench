{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./out/projects/legacy.tsbuildinfo"
  },
  "references": [
    { "path": "./src/mo2Codecs" },
    { "path": "./src/tables" },
    { "path": "./src/wire" },
    { "path": "./src/ports" },
    { "path": "./src/mo2Files" },
    { "path": "./src/instance" },
    { "path": "./src/modlist" },
    { "path": "./src/pluginsCommands" },
    { "path": "./src/instanceCommands" },
    { "path": "./src/install" },
    { "path": "./src/deploy" },
    { "path": "./src/client" },
    { "path": "./src/mods" },
    { "path": "./src/downloads" },
    { "path": "./src/plugins" },
    { "path": "./src/editor" }
  ],
  "include": ["src"],
  "exclude": [
    "node_modules",
    "out",
    "webview",
    "src/mo2Codecs/*.ts",
    "src/tables/*.ts",
    "src/wire/*.ts",
    "src/wire/generated",
    "src/ports/*.ts",
    "src/mo2Files/*.ts",
    "src/instance/*.ts",
    "src/modlist/*.ts",
    "src/pluginsCommands/*.ts",
    "src/instanceCommands/*.ts",
    "src/install/*.ts",
    "src/deploy/*.ts",
    "src/client/*.ts",
    "src/mods/*.ts",
    "src/downloads/*.ts",
    "src/plugins/*.ts",
    "src/editor/*.ts"
  ]
}
