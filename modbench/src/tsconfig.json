{
  "extends": "../tsconfig.box.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../out/projects/root",
    // The composition root: the activation file and its wiring compose every box onto the
    // extension host, and reference every box by definition (target-architecture-references.d2).
    "types": ["node", "vscode"]
  },
  "references": [
    { "path": "./mo2Codecs" },
    { "path": "./tables" },
    { "path": "./wire" },
    { "path": "./ports" },
    { "path": "./instanceAdapter" },
    { "path": "./instanceLoader" },
    { "path": "./modlist" },
    { "path": "./pluginsCommands" },
    { "path": "./instanceCommands" },
    { "path": "./downloadsCommands" },
    { "path": "./install" },
    { "path": "./client" },
    { "path": "./toolbox" },
    { "path": "./mods" },
    { "path": "./downloads" },
    { "path": "./plugins" },
    { "path": "./editor" }
  ],
  "include": ["*.ts", "medit/*.ts"],
  "exclude": ["**/*.test.ts"]
}
