{
  "extends": "../../tsconfig.box.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../out/projects/mods",
    // A view is a driving adapter: it reads a value and fires a command through VS Code's own
    // trees, panels and palette, so the extension host is its whole reason to exist.
    "types": ["node", "vscode"]
  },
  "references": [
    { "path": "../client" },
    { "path": "../drivingLib" },
    { "path": "../instanceAdapter" },
    { "path": "../manifestAdapter" },
    { "path": "../modStatus" },
    { "path": "../instanceLoader" },
    { "path": "../modCommands" },
    { "path": "../ports" },
    { "path": "../sourceCommands" },
    { "path": "../wire" }
  ],
  "include": ["**/*.ts"],
  "exclude": ["test", "**/*.test.ts"]
}
