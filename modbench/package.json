        },
        {
          "command": "modbench.modList.purge",
          "when": "modbench.workspaceIsMo2Instance && modbench.deploymentStandalone"
        },
        {
          "command": "modbench.launch",
          "when": "modbench.workspaceIsMo2Instance && modbench.deploymentStandalone"
        },
        {
