      "view/title": [
        {
          "command": "modbench.refresh",
          "when": "view == modbench.loadoutHeader",
          "group": "navigation@1"
        },
        {
          "command": "modbench.launch",
          "when": "view == modbench.loadoutHeader && modbench.workspaceIsMo2Instance && modbench.deploymentStandalone",
          "group": "navigation@2"
        },
        {
          "command": "modbench.modList.deploy",
          "when": "view == modbench.loadoutHeader && modbench.workspaceIsMo2Instance && modbench.deploymentStandalone",
          "group": "2_deployment"
        },
        {
          "command": "modbench.modList.purge",
          "when": "view == modbench.loadoutHeader && modbench.workspaceIsMo2Instance && modbench.deploymentStandalone",
          "group": "2_deployment"
        },
        {
          "command": "modbench.reloadSession",
          "when": "view == modbench.loadoutHeader",
          "group": "1_session"
        },
        {
          "command": "modbench.pluginListTree.filter",
          "when": "view == modbench.pluginListTree",
          "group": "navigation@1"
        },
        {
          "command": "modbench.setFilter",
          "when": "view == modbench.pluginListTree",
          "group": "navigation@2"
        },
        {
          "command": "modbench.clearFilter",
          "when": "view == modbench.pluginListTree && modbench.filterActive",
          "group": "navigation@2"
        },
        {
          "command": "modbench.newPlugin",
          "when": "view == modbench.pluginListTree",
          "group": "navigation@3"
        },
        {
          "command": "modbench.modList.filter",
          "when": "view == modbench.modList",
          "group": "navigation@1"
        },
        {
          "command": "modbench.modList.sortDescending",
          "when": "view == modbench.modList && !modbench.modList.sortDescending",
          "group": "navigation@2"
        },
        {
          "command": "modbench.modList.sortAscending",
          "when": "view == modbench.modList && modbench.modList.sortDescending",
          "group": "navigation@2"
        },
        {
          "command": "modbench.downloads.filter",
          "when": "view == modbench.downloads",
          "group": "navigation@1"
        },
        {
          "command": "modbench.downloads.showHidden",
          "when": "view == modbench.downloads && !modbench.downloads.showHidden",
          "group": "navigation@2"
        },
        {
          "command": "modbench.downloads.hideHidden",
          "when": "view == modbench.downloads && modbench.downloads.showHidden",
          "group": "navigation@2"
        },
        {
          "command": "modbench.downloads.sortBy",
          "when": "view == modbench.downloads",
          "group": "1_sort"
        },
        {
          "command": "modbench.saveAllGroups",
          "when": "view == modbench.changeGroupTree && modbench.hasPendingChanges",
          "group": "navigation@1"
        },
        {
          "command": "modbench.revertAllGroups",
          "when": "view == modbench.changeGroupTree && modbench.hasPendingChanges",
          "group": "1_revert"
        }
      ],
      "editor/title": [
        {
          "command": "modbench.clearFilter",
          "when": "modbench.filterActive",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "modbench.openHeader",
          "when": "view == modbench.pluginListTree && (viewItem == plugin || viewItem == pluginImplicit)",
          "group": "modbench@1"
        },
        {
          "command": "modbench.openHeader",
          "when": "view == modbench.pluginListTree && (viewItem == plugin || viewItem == pluginImplicit)",
          "group": "inline"
        },
        {
          "command": "modbench.copyAsOverrideInto",
          "when": "view == modbench.pluginListTree && (viewItem == record || viewItem == recordImmutable || viewItem == refr || viewItem == refrImmutable)",
          "group": "modbench@1"
        },
        {
          "command": "modbench.copyAsNewRecord",
          "when": "view == modbench.pluginListTree && (viewItem == record || viewItem == recordImmutable || viewItem == refr || viewItem == refrImmutable)",
          "group": "modbench@2"
        },
        {
          "command": "modbench.deleteRecord",
          "when": "view == modbench.pluginListTree && (viewItem == record || viewItem == refr)",
          "group": "modbench@3"
        },
        {
          "command": "modbench.createPlaced",
          "when": "view == modbench.pluginListTree && (viewItem == placedGroup-persistent || viewItem == placedGroup-temporary)",
          "group": "modbench@1"
        },
        {
          "command": "modbench.saveGroup",
          "when": "view == modbench.changeGroupTree && viewItem == pendingGroup",
          "group": "inline"
        },
        {
          "command": "modbench.openEditor",
          "when": "view == modbench.referencedByTree && viewItem == referencedByGroup",
          "group": "modbench@1"
        },
        {
          "command": "modbench.openEditorBeside",
          "when": "view == modbench.referencedByTree && viewItem == referencedByGroup",
          "group": "modbench@2"
        },
        {
          "command": "modbench.referencedByTree.copy",
          "when": "view == modbench.referencedByTree && viewItem == referencedByGroup",
          "group": "modbench@3"
        },
        {
          "command": "modbench.modList.mod.openInExplorer",
          "when": "view == modbench.modList && viewItem == mod",
          "group": "modActions@1"
        },
        {
          "command": "modbench.modList.mod.addSeparatorBelow",
          "when": "view == modbench.modList && viewItem == mod",
          "group": "modActions@2"
        },
        {
          "command": "modbench.modList.mod.moveToSeparator",
          "when": "view == modbench.modList && viewItem == mod",
          "group": "modActions@3"
        },
        {
          "command": "modbench.modList.mod.uninstall",
          "when": "view == modbench.modList && viewItem == mod",
          "group": "modActions@4"
        },
        {
          "command": "modbench.modList.mod.openInExplorer",
          "when": "view == modbench.modList && viewItem == modWithNexus",
          "group": "modActions@1"
        },
        {
          "command": "modbench.modList.mod.addSeparatorBelow",
          "when": "view == modbench.modList && viewItem == modWithNexus",
          "group": "modActions@2"
        },
        {
          "command": "modbench.modList.mod.moveToSeparator",
          "when": "view == modbench.modList && viewItem == modWithNexus",
          "group": "modActions@3"
        },
        {
          "command": "modbench.modList.mod.uninstall",
          "when": "view == modbench.modList && viewItem == modWithNexus",
          "group": "modActions@4"
        },
        {
          "command": "modbench.modList.mod.viewOnNexus",
          "when": "view == modbench.modList && viewItem == modWithNexus",
          "group": "modActions@5"
        },
        {
          "command": "modbench.modList.separator.rename",
          "when": "view == modbench.modList && viewItem == separator",
          "group": "sepActions@1"
        },
        {
          "command": "modbench.modList.separator.addSeparatorBelow",
          "when": "view == modbench.modList && viewItem == separator",
          "group": "sepActions@2"
        },
        {
          "command": "modbench.modList.separator.delete",
          "when": "view == modbench.modList && viewItem == separator",
          "group": "sepActions@3"
        },
        {
          "command": "modbench.modList.overwrite.reveal",
          "when": "view == modbench.modList && viewItem == overwrite",
          "group": "overwriteActions@1"
        },
        {
          "command": "modbench.downloads.install",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/",
          "group": "downloadActions@1"
        },
        {
          "command": "modbench.downloads.visitNexus",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/ && viewItem =~ /\\bhasModID\\b/",
          "group": "downloadActions@2"
        },
        {
          "command": "modbench.downloads.openFile",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/",
          "group": "downloadActions@3"
        },
        {
          "command": "modbench.downloads.openMeta",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/ && viewItem =~ /\\bhasMeta\\b/",
          "group": "downloadActions@4"
        },
        {
          "command": "modbench.downloads.delete",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/",
          "group": "downloadActions@5"
        },
        {
          "command": "modbench.downloads.hide",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/ && !(viewItem =~ /\\bhidden\\b/)",
          "group": "downloadActions@6"
        },
        {
          "command": "modbench.downloads.unhide",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/ && viewItem =~ /\\bhidden\\b/",
          "group": "downloadActions@6"
        },
        {
          "command": "modbench.pluginListTree.revealInExplorer",
          "when": "view == modbench.pluginListTree && viewItem == plugin",
          "group": "pluginActions@1"
        },
        {
          "command": "modbench.revertGroup",
          "when": "view == modbench.changeGroupTree && viewItem == pendingGroup",
          "group": "inline"
        }
      ],
      "webview/context": [
        {
          "command": "modbench.pendingCell.reveal",
          "when": "webviewId == 'modbench' && webviewSection == 'pendingCell'",
          "group": "modbench@1"
        },
        {
          "command": "modbench.pendingCell.saveGroup",
          "when": "webviewId == 'modbench' && webviewSection == 'pendingCell'",
          "group": "modbench@2"
        },
        {
          "command": "modbench.pendingCell.revertGroup",
          "when": "webviewId == 'modbench' && webviewSection == 'pendingCell'",
          "group": "modbench@3"
        },
        {
          "command": "modbench.copyAsOverrideInto",
          "when": "webviewId == 'modbench' && webviewSection == 'columnHeader'",
          "group": "modbench@5"
        },
        {
          "command": "modbench.copyAsNewRecord",
          "when": "webviewId == 'modbench' && webviewSection == 'columnHeader'",
          "group": "modbench@6"
        },
        {
          "command": "modbench.deleteRecord",
          "when": "webviewId == 'modbench' && webviewSection == 'columnHeader' && !immutable",
          "group": "modbench@8"
        },
        {
          "command": "modbench.array.add",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\barrayParent\\b/",
          "group": "modbench@9"
        },
        {
          "command": "modbench.array.remove",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\barrayElement\\b/",
          "group": "modbench@10"
        },
        {
          "command": "modbench.array.moveUp",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\barrayElement\\b/ && canMoveUp",
          "group": "modbench@11"
        },
        {
          "command": "modbench.array.moveDown",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\barrayElement\\b/ && canMoveDown",
          "group": "modbench@12"
        },
        {
          "command": "modbench.vmad.addScript",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\bvmadScripts\\b/",
          "group": "modbench@13"
        },
        {
          "command": "modbench.vmad.addProperty",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\bvmadScript\\b/",
          "group": "modbench@14"
        },
        {
          "command": "modbench.vmad.removeScript",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\bvmadScript\\b/",
          "group": "modbench@15"
        },
        {
          "command": "modbench.vmad.removeProperty",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\bvmadProperty\\b/",
          "group": "modbench@16"
        },
        {
          "command": "modbench.vmad.setScriptFlags",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\bvmadScript\\b/",
          "group": "modbench@17"
        },
        {
          "command": "modbench.vmad.setPropertyFlags",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\bvmadProperty\\b/",
          "group": "modbench@18"
        }
      ]
    },
    "keybindings": [
      {
        "command": "modbench.deleteRecord",
        "key": "Delete",
        "when": "focusedView == modbench.pluginListTree && (viewItem == record || viewItem == refr)"
      },
      {
        "command": "modbench.referencedByTree.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == modbench.referencedByTree"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run build:backend",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit && node esbuild.mjs && npm run build:webview",
    "build:webview": "VITE_CJS_IGNORE_WARNING=1 vite build --config webview/vite.config.ts",
    "build:backend": "dotnet publish ../MEditService/MEditService.Api/MEditService.Api.csproj -c Release --self-contained -r linux-x64 -o backend",
    "watch": "node esbuild.mjs --watch",
    "generate-api": "openapi-typescript http://localhost:5172/swagger/v1/swagger.json -o src/medit/generated/api.ts",
    "test:unit": "vitest run",
    "test:mutation": "stryker run",
    "pretest:integration": "node esbuild.mjs",
    "test:integration": "tsc -p tsconfig.integration.json && vscode-test",
    "lint": "eslint src webview/src",
    "prepackage": "cp ../LICENSE ./LICENSE",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
