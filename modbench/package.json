{
  "name": "modbench",
  "displayName": "Modbench",
  "description": "Modbench: install and order mods; view, edit, and compare Bethesda plugin files (.esp/.esm/.esl)",
  "version": "0.0.1",
  "publisher": "whiskytangofawks",
  "license": "GPL-3.0-only",
  "icon": "images/medit.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhiskyTangoFawks/ModBench.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Modbench",
      "properties": {
        "modbench.backendPort": {
          "type": "number",
          "default": 5172,
          "description": "Port the mEdit backend API listens on."
        },
        "modbench.scriptsPath": {
          "type": "string",
          "default": "",
          "description": "Path to folder containing .sql filter files and .py scripts. Defaults to ~/.medit/scripts."
        },
        "modbench.mods.gameDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The game directory (the folder containing the game executable and Data/). A Steam install or a stock game folder. Leave blank to fall back to ModOrganizer.ini's gamePath, then Steam auto-detect."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modbench",
          "title": "Modbench",
          "icon": "images/medit.svg"
        }
      ],
      "panel": [
        {
          "id": "modbenchReferencedBy",
          "title": "Referenced By",
          "icon": "images/medit.svg"
        }
      ]
    },
    "views": {
      "modbench": [
        {
          "id": "modbench.toolbox",
          "name": "Toolbox"
        },
        {
          "id": "modbench.modList",
          "name": "Mods"
        },
        {
          "id": "modbench.pluginListTree",
          "name": "Plugins"
        },
        {
          "id": "modbench.downloads",
          "name": "Downloads",
          "visibility": "collapsed"
        }
      ],
      "modbenchReferencedBy": [
        {
          "id": "modbench.referencedByTree",
          "name": "Plugins - Referenced By"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "modbench.toolbox",
        "contents": "No mod manager instance is open.\nOpen the folder of an instance Modbench recognizes.\n[Open Folder…](command:vscode.openFolder)",
        "when": "modbench.folder == notAnInstance"
      },
      {
        "view": "modbench.modList",
        "contents": "No mod manager instance is open.\nOpen the folder of an instance Modbench recognizes.\n[Open Folder…](command:vscode.openFolder)",
        "when": "modbench.folder == notAnInstance"
      },
      {
        "view": "modbench.pluginListTree",
        "contents": "No mod manager instance is open.\nOpen the folder of an instance Modbench recognizes.\n[Open Folder…](command:vscode.openFolder)",
        "when": "modbench.folder == notAnInstance"
      },
      {
        "view": "modbench.downloads",
        "contents": "No mod manager instance is open.\nOpen the folder of an instance Modbench recognizes.\n[Open Folder…](command:vscode.openFolder)",
        "when": "modbench.folder == notAnInstance"
      },
      {
        "view": "modbench.downloads",
        "contents": "No downloads yet. Copy archives into the downloads folder to see them here.",
        "when": "modbench.folder == instance && modbench.instanceRead && !modbench.downloadedFile.allExcluded"
      },
      {
        "view": "modbench.downloads",
        "contents": "All downloaded files are excluded. Show excluded, in the title bar, reveals them.",
        "when": "modbench.folder == instance && modbench.instanceRead && modbench.downloadedFile.allExcluded"
      }
    ],
    "commands": [
      {
        "command": "modbench.openEditor",
        "title": "Open Editor",
        "category": "Modbench"
      },
      {
        "command": "modbench.openEditorBeside",
        "title": "Open Editor to the Side",
        "category": "Modbench"
      },
      {
        "command": "modbench.openCompare",
        "title": "Open Compare",
        "category": "Modbench"
      },
      {
        "command": "modbench.openHeader",
        "title": "Open Header",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.addElement",
        "title": "Add Record Element",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.removeElement",
        "title": "Remove Record Element",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.moveElementUp",
        "title": "Move Record Element Up",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.moveElementDown",
        "title": "Move Record Element Down",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.openFieldValue",
        "title": "Open Record Field Value…",
        "category": "Modbench"
      },
      {
        "command": "modbench.instance.refresh",
        "title": "Refresh Instance",
        "icon": "$(refresh)",
        "category": "Modbench"
      },
      {
        "command": "modbench.settings.open",
        "title": "Open Settings",
        "category": "Modbench"
      },
      {
        "command": "modbench.instance.putLoadOrder",
        "title": "Put Instance Load Order",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.sync",
        "title": "Sync Mods",
        "category": "Modbench"
      },
      {
        "command": "modbench.plugin.sync",
        "title": "Sync Plugins",
        "category": "Modbench"
      },
      {
        "command": "modbench.plugin.create",
        "title": "Create Plugin…",
        "icon": "$(add)",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.filter",
        "title": "Filter Records…",
        "icon": "$(filter)",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.clearFilter",
        "title": "Clear Record Filter",
        "icon": "$(clear-all)",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.showReferencedBy",
        "title": "Show Record Referenced By",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.copyValue",
        "title": "Copy Record Value",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.filter",
        "title": "Filter Mods…",
        "icon": "$(search)",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.clearFilter",
        "title": "Clear Mods Filter",
        "icon": "$(clear-all)",
        "category": "Modbench"
      },
      {
        "command": "modbench.profile.switch",
        "title": "Switch Profile…",
        "icon": "$(account)",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.sortWinningAtTop",
        "title": "Sort Mods Winning at Top",
        "icon": "$(triangle-down)",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.sortLosingAtTop",
        "title": "Sort Mods Losing at Top",
        "icon": "$(triangle-up)",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.createEmpty",
        "title": "Create Empty Mod…",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.install",
        "title": "Install Mod…",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.openFolder",
        "title": "Open Mod Folder",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.enable",
        "title": "Enable Mod",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.disable",
        "title": "Disable Mod",
        "category": "Modbench"
      },
      {
        "command": "modbench.separator.add",
        "title": "Add Separator…",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.move",
        "title": "Move Mod…",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.uninstall",
        "title": "Uninstall Mod…",
        "category": "Modbench"
      },
      {
        "command": "modbench.mod.viewOnNexus",
        "title": "View Mod on Nexus",
        "category": "Modbench"
      },
      {
        "command": "modbench.separator.rename",
        "title": "Rename Separator…",
        "category": "Modbench"
      },
      {
        "command": "modbench.separator.delete",
        "title": "Delete Separator",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloads.install",
        "title": "Install",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.open",
        "title": "Open Downloaded File",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.openMeta",
        "title": "Open Downloaded File Meta",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.delete",
        "title": "Delete Downloaded File",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.exclude",
        "title": "Exclude Downloaded File",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.include",
        "title": "Include Downloaded File",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.filter",
        "title": "Filter Downloaded Files…",
        "icon": "$(search)",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.clearFilter",
        "title": "Clear Downloaded Files Filter",
        "icon": "$(clear-all)",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.sort",
        "title": "Sort Downloaded Files…",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.showExcluded",
        "title": "Show Excluded Downloaded Files",
        "icon": "$(eye-closed)",
        "category": "Modbench"
      },
      {
        "command": "modbench.downloadedFile.hideExcluded",
        "title": "Hide Excluded Downloaded Files",
        "icon": "$(eye)",
        "category": "Modbench"
      },
      {
        "command": "modbench.plugin.filter",
        "title": "Filter Plugins…",
        "icon": "$(search)",
        "category": "Modbench"
      },
      {
        "command": "modbench.plugin.clearFilter",
        "title": "Clear Plugins Filter",
        "icon": "$(clear-all)",
        "category": "Modbench"
      },
      {
        "command": "modbench.plugin.reveal",
        "title": "Reveal Plugin",
        "category": "Modbench"
      },
      {
        "command": "modbench.plugin.enable",
        "title": "Enable Plugin",
        "category": "Modbench"
      },
      {
        "command": "modbench.plugin.disable",
        "title": "Disable Plugin",
        "category": "Modbench"
      },
      {
        "command": "modbench.plugin.track",
        "title": "Track Plugin…",
        "category": "Modbench"
      },
      {
        "command": "modbench.saveAndCompile",
        "title": "Compile Plugin",
        "category": "Modbench"
      },
      {
        "command": "modbench.pluginListTree.compileAtMain",
        "title": "Compile Plugin from main…",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.create",
        "title": "Add",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.delete",
        "title": "Remove",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.copyAsOverride",
        "title": "Copy as Override Into…",
        "category": "Modbench"
      },
      {
        "command": "modbench.record.copyAsNewRecord",
        "title": "Copy as New Record Into…",
        "category": "Modbench"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "modbench.openHeader",
          "when": "false"
        },
        {
          "command": "modbench.record.addElement",
          "when": "activeWebviewPanelId == 'modbench' && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && modbench.record.focusedCellSection =~ /\\barrayParent\\b/"
        },
        {
          "command": "modbench.record.removeElement",
          "when": "activeWebviewPanelId == 'modbench' && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && modbench.record.focusedCellSection =~ /\\barrayElement\\b/"
        },
        {
          "command": "modbench.record.moveElementUp",
          "when": "activeWebviewPanelId == 'modbench' && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && modbench.record.focusedCellSection =~ /\\barrayElement\\b/ && modbench.record.focusedCellCanMoveUp"
        },
        {
          "command": "modbench.record.moveElementDown",
          "when": "activeWebviewPanelId == 'modbench' && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && modbench.record.focusedCellSection =~ /\\barrayElement\\b/ && modbench.record.focusedCellCanMoveDown"
        },
        {
          "command": "modbench.record.openFieldValue",
          "when": "activeWebviewPanelId == 'modbench' && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && modbench.record.focusedCellSection =~ /\\bstringValue\\b/"
        },
        {
          "command": "modbench.downloads.install",
          "when": "false"
        },
        {
          "command": "modbench.mod.viewOnNexus",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.nexusRowIn == modbench.modList || focusedView == modbench.downloads && modbench.folder == instance && modbench.mod.nexusRowIn == modbench.downloads"
        },
        {
          "command": "modbench.downloadedFile.open",
          "when": "focusedView == modbench.downloads && modbench.folder == instance && modbench.downloadedFile.singleFile"
        },
        {
          "command": "modbench.downloadedFile.openMeta",
          "when": "focusedView == modbench.downloads && modbench.folder == instance && modbench.downloadedFile.singleFileWithMeta"
        },
        {
          "command": "modbench.downloadedFile.delete",
          "when": "focusedView == modbench.downloads && modbench.folder == instance && modbench.downloadedFile.holdsFile"
        },
        {
          "command": "modbench.downloadedFile.exclude",
          "when": "focusedView == modbench.downloads && modbench.folder == instance && modbench.downloadedFile.holdsIncluded"
        },
        {
          "command": "modbench.downloadedFile.include",
          "when": "focusedView == modbench.downloads && modbench.folder == instance && modbench.downloadedFile.holdsExcluded"
        },
        {
          "command": "modbench.mod.openFolder",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.singleFolder"
        },
        {
          "command": "modbench.mod.enable",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.holdsDisabledMod"
        },
        {
          "command": "modbench.mod.disable",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.holdsEnabledMod"
        },
        {
          "command": "modbench.separator.add",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.selectionKind && modbench.mod.singleRow"
        },
        {
          "command": "modbench.mod.move",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.selectionKind"
        },
        {
          "command": "modbench.mod.uninstall",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.selectionKind == mod"
        },
        {
          "command": "modbench.separator.rename",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.selectionKind == separator && modbench.mod.singleRow"
        },
        {
          "command": "modbench.separator.delete",
          "when": "focusedView == modbench.modList && modbench.folder == instance && modbench.mod.selectionKind == separator"
        },
        {
          "command": "modbench.plugin.reveal",
          "when": "focusedView == modbench.pluginListTree && modbench.folder == instance && modbench.plugin.singlePlugin"
        },
        {
          "command": "modbench.plugin.enable",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.plugin.disable",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.plugin.track",
          "when": "focusedView == modbench.pluginListTree && modbench.folder == instance && modbench.plugin.allUntrackedInMod"
        },
        {
          "command": "modbench.pluginListTree.compileAtMain",
          "when": "false"
        },
        {
          "command": "modbench.saveAndCompile",
          "when": "modbench.folder == instance && modbench.plugin.anyCompilable"
        },
        {
          "command": "modbench.record.create",
          "when": "focusedView == modbench.pluginListTree && modbench.folder == instance && modbench.plugin.singleRecordType"
        },
        {
          "command": "modbench.record.delete",
          "when": "focusedView == modbench.pluginListTree && modbench.folder == instance && modbench.plugin.allDeletableRecords"
        },
        {
          "command": "modbench.record.copyAsOverride",
          "when": "false"
        },
        {
          "command": "modbench.record.copyAsNewRecord",
          "when": "false"
        },
        {
          "command": "modbench.instance.putLoadOrder",
          "when": "false"
        },
        {
          "command": "modbench.mod.sync",
          "when": "false"
        },
        {
          "command": "modbench.plugin.sync",
          "when": "false"
        },
        {
          "command": "modbench.mod.filter",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.mod.clearFilter",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.profile.switch",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.instance.refresh",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.settings.open",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.mod.sortWinningAtTop",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.mod.sortLosingAtTop",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.mod.createEmpty",
          "when": "focusedView == modbench.modList && modbench.folder == instance"
        },
        {
          "command": "modbench.mod.install",
          "when": "focusedView == modbench.modList && modbench.folder == instance"
        },
        {
          "command": "modbench.downloadedFile.filter",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.downloadedFile.clearFilter",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.downloadedFile.sort",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.downloadedFile.showExcluded",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.downloadedFile.hideExcluded",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.plugin.create",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.plugin.filter",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.plugin.clearFilter",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.record.filter",
          "when": "modbench.folder == instance"
        },
        {
          "command": "modbench.record.clearFilter",
          "when": "modbench.folder == instance"
        }
      ],
      "view/title": [
        {
          "command": "modbench.instance.refresh",
          "when": "view == modbench.toolbox && modbench.folder == instance",
          "group": "navigation@1"
        },
        {
          "command": "modbench.settings.open",
          "when": "view == modbench.toolbox && modbench.folder == instance",
          "group": "settings@1"
        },
        {
          "command": "modbench.plugin.filter",
          "when": "view == modbench.pluginListTree && !modbench.plugin.filterActive && modbench.folder == instance",
          "group": "navigation@1"
        },
        {
          "command": "modbench.plugin.clearFilter",
          "when": "view == modbench.pluginListTree && modbench.plugin.filterActive && modbench.folder == instance",
          "group": "navigation@1"
        },
        {
          "command": "modbench.record.filter",
          "when": "view == modbench.pluginListTree && !modbench.record.filterActive && modbench.folder == instance",
          "group": "navigation@3"
        },
        {
          "command": "modbench.record.clearFilter",
          "when": "view == modbench.pluginListTree && modbench.record.filterActive && modbench.folder == instance",
          "group": "navigation@3"
        },
        {
          "command": "modbench.plugin.create",
          "when": "view == modbench.pluginListTree && modbench.folder == instance",
          "group": "navigation@4"
        },
        {
          "command": "modbench.mod.filter",
          "when": "view == modbench.modList && !modbench.mod.filterActive && modbench.folder == instance",
          "group": "navigation@1"
        },
        {
          "command": "modbench.mod.clearFilter",
          "when": "view == modbench.modList && modbench.mod.filterActive && modbench.folder == instance",
          "group": "navigation@1"
        },
        {
          "command": "modbench.mod.sortWinningAtTop",
          "when": "view == modbench.modList && !modbench.mod.winningAtTop && modbench.folder == instance",
          "group": "navigation@2"
        },
        {
          "command": "modbench.mod.sortLosingAtTop",
          "when": "view == modbench.modList && modbench.mod.winningAtTop && modbench.folder == instance",
          "group": "navigation@2"
        },
        {
          "command": "modbench.mod.install",
          "when": "view == modbench.modList && modbench.folder == instance",
          "group": "3_create@1"
        },
        {
          "command": "modbench.mod.createEmpty",
          "when": "view == modbench.modList && modbench.folder == instance",
          "group": "3_create@2"
        },
        {
          "command": "modbench.downloadedFile.filter",
          "when": "view == modbench.downloads && !modbench.downloadedFile.filterActive && modbench.folder == instance",
          "group": "navigation@1"
        },
        {
          "command": "modbench.downloadedFile.clearFilter",
          "when": "view == modbench.downloads && modbench.downloadedFile.filterActive && modbench.folder == instance",
          "group": "navigation@1"
        },
        {
          "command": "modbench.downloadedFile.showExcluded",
          "when": "view == modbench.downloads && !modbench.downloadedFile.excludedShown && modbench.folder == instance",
          "group": "navigation@2"
        },
        {
          "command": "modbench.downloadedFile.hideExcluded",
          "when": "view == modbench.downloads && modbench.downloadedFile.excludedShown && modbench.folder == instance",
          "group": "navigation@2"
        },
        {
          "command": "modbench.downloadedFile.sort",
          "when": "view == modbench.downloads && modbench.folder == instance",
          "group": "1_sort"
        }
      ],
      "view/item/context": [
        {
          "command": "modbench.profile.switch",
          "when": "view == modbench.toolbox && viewItem == profile",
          "group": "modbench@1"
        },
        {
          "command": "modbench.openEditor",
          "when": "view == modbench.referencedByTree && viewItem == referencedByGroup",
          "group": "modbench@1"
        },
        {
          "command": "modbench.openEditorBeside",
          "when": "view == modbench.referencedByTree && viewItem == referencedByGroup",
          "group": "modbench@2"
        },
        {
          "command": "modbench.record.copyValue",
          "when": "view == modbench.referencedByTree && viewItem == referencedByGroup",
          "group": "modbench@3"
        },
        {
          "command": "modbench.mod.openFolder",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/",
          "group": "1_open@1"
        },
        {
          "command": "modbench.mod.viewOnNexus",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/ && viewItem =~ /\\bhasNexus\\b/",
          "group": "1_open@2"
        },
        {
          "command": "modbench.mod.enable",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/ && viewItem =~ /\\bdisabled\\b/",
          "group": "2_change@1"
        },
        {
          "command": "modbench.mod.disable",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/ && viewItem =~ /\\benabled\\b/",
          "group": "2_change@1"
        },
        {
          "command": "modbench.separator.add",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/",
          "group": "3_create@1"
        },
        {
          "command": "modbench.mod.createEmpty",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/",
          "group": "3_create@2"
        },
        {
          "command": "modbench.mod.install",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/",
          "group": "3_create@3"
        },
        {
          "command": "modbench.mod.move",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/",
          "group": "2_change@2"
        },
        {
          "command": "modbench.mod.uninstall",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/",
          "group": "6_destroy@1"
        },
        {
          "command": "modbench.record.copyValue",
          "when": "view == modbench.modList && viewItem =~ /\\bmod\\b/",
          "group": "5_copy@1"
        },
        {
          "command": "modbench.mod.move",
          "when": "view == modbench.modList && viewItem == separator",
          "group": "2_change@1"
        },
        {
          "command": "modbench.separator.rename",
          "when": "view == modbench.modList && viewItem == separator",
          "group": "3_create@2"
        },
        {
          "command": "modbench.separator.add",
          "when": "view == modbench.modList && viewItem == separator",
          "group": "3_create@1"
        },
        {
          "command": "modbench.separator.delete",
          "when": "view == modbench.modList && viewItem == separator",
          "group": "6_destroy@1"
        },
        {
          "command": "modbench.record.copyValue",
          "when": "view == modbench.modList && viewItem == separator",
          "group": "5_copy@1"
        },
        {
          "command": "modbench.mod.openFolder",
          "when": "view == modbench.modList && viewItem == overwrite",
          "group": "1_open@1"
        },
        {
          "command": "modbench.downloads.install",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/",
          "group": "downloadActions@1"
        },
        {
          "command": "modbench.mod.viewOnNexus",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/ && viewItem =~ /\\bhasModID\\b/",
          "group": "downloadActions@2"
        },
        {
          "command": "modbench.downloadedFile.open",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/",
          "group": "downloadActions@3"
        },
        {
          "command": "modbench.downloadedFile.openMeta",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/ && viewItem =~ /\\bhasMeta\\b/",
          "group": "downloadActions@4"
        },
        {
          "command": "modbench.downloadedFile.exclude",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/ && !(viewItem =~ /\\bexcluded\\b/)",
          "group": "downloadActions@5"
        },
        {
          "command": "modbench.downloadedFile.include",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/ && viewItem =~ /\\bexcluded\\b/",
          "group": "downloadActions@5"
        },
        {
          "command": "modbench.downloadedFile.delete",
          "when": "view == modbench.downloads && viewItem =~ /\\bdownload\\b/",
          "group": "downloadActions@6"
        },
        {
          "command": "modbench.plugin.reveal",
          "when": "view == modbench.pluginListTree && viewItem =~ /\\bplugin\\b/",
          "group": "pluginActions@1"
        },
        {
          "command": "modbench.plugin.track",
          "when": "view == modbench.pluginListTree && viewItem =~ /\\buntrackedInMod\\b/",
          "group": "pluginActions@2"
        },
        {
          "command": "modbench.saveAndCompile",
          "when": "view == modbench.pluginListTree && viewItem =~ /\\bcompilable\\b/",
          "group": "pluginActions@3"
        },
        {
          "command": "modbench.pluginListTree.compileAtMain",
          "when": "view == modbench.pluginListTree && viewItem =~ /\\bcompilable\\b/",
          "group": "pluginActions@4"
        },
        {
          "command": "modbench.record.create",
          "when": "view == modbench.pluginListTree && viewItem == recordType",
          "group": "recordTypeActions@1"
        },
        {
          "command": "modbench.openEditorBeside",
          "when": "view == modbench.pluginListTree && (viewItem == recordTracked || viewItem == recordUntracked || viewItem == recordOverride || viewItem == recordImmutable || viewItem == refr || viewItem == refrImmutable)",
          "group": "modbench@1"
        },
        {
          "command": "modbench.record.delete",
          "when": "view == modbench.pluginListTree && (viewItem == recordTracked || viewItem == recordUntracked || viewItem == recordOverride)",
          "group": "recordActions@1"
        },
        {
          "command": "modbench.record.copyAsOverride",
          "when": "view == modbench.pluginListTree && (viewItem == recordTracked || viewItem == recordUntracked || viewItem == recordOverride || viewItem == recordImmutable)",
          "group": "recordActions@2"
        },
        {
          "command": "modbench.record.copyAsNewRecord",
          "when": "view == modbench.pluginListTree && (viewItem == recordTracked || viewItem == recordUntracked || viewItem == recordOverride || viewItem == recordImmutable)",
          "group": "recordActions@3"
        }
      ],
      "webview/context": [
        {
          "command": "modbench.record.addElement",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\barrayParent\\b/",
          "group": "modbench@1"
        },
        {
          "command": "modbench.record.removeElement",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\barrayElement\\b/",
          "group": "modbench@2"
        },
        {
          "command": "modbench.record.moveElementUp",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\barrayElement\\b/ && canMoveUp",
          "group": "modbench@3"
        },
        {
          "command": "modbench.record.moveElementDown",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\barrayElement\\b/ && canMoveDown",
          "group": "modbench@4"
        },
        {
          "command": "modbench.saveAndCompile",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\brecordHeader\\b/ && compilable",
          "group": "modbench@10"
        },
        {
          "command": "modbench.record.copyAsOverride",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\brecordHeader\\b/",
          "group": "modbench@11"
        },
        {
          "command": "modbench.record.copyAsNewRecord",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\brecordHeader\\b/",
          "group": "modbench@12"
        },
        {
          "command": "modbench.record.openFieldValue",
          "when": "webviewId == 'modbench' && webviewSection =~ /\\bstringValue\\b/",
          "group": "modbench@13"
        }
      ]
    },
    "keybindings": [
      {
        "command": "modbench.mod.enable",
        "key": "space",
        "when": "focusedView == modbench.modList && listFocus && !inputFocus && modbench.folder == instance && modbench.mod.selectionToggle == enable"
      },
      {
        "command": "modbench.mod.disable",
        "key": "space",
        "when": "focusedView == modbench.modList && listFocus && !inputFocus && modbench.folder == instance && modbench.mod.selectionToggle == disable"
      },
      {
        "command": "modbench.mod.uninstall",
        "key": "Delete",
        "mac": "cmd+backspace",
        "when": "focusedView == modbench.modList && listFocus && !inputFocus && modbench.folder == instance && modbench.mod.selectionKind == mod"
      },
      {
        "command": "modbench.separator.delete",
        "key": "Delete",
        "mac": "cmd+backspace",
        "when": "focusedView == modbench.modList && listFocus && !inputFocus && modbench.folder == instance && modbench.mod.selectionKind == separator"
      },
      {
        "command": "modbench.separator.rename",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == modbench.modList && listFocus && !inputFocus && modbench.folder == instance && modbench.mod.selectionKind == separator && modbench.mod.singleRow"
      },
      {
        "command": "modbench.record.copyValue",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == modbench.modList && listFocus && !inputFocus && modbench.folder == instance",
        "args": {
          "view": "modbench.modList"
        }
      },
      {
        "command": "modbench.downloadedFile.delete",
        "key": "Delete",
        "mac": "cmd+backspace",
        "when": "focusedView == modbench.downloads && listFocus && !inputFocus && modbench.folder == instance"
      },
      {
        "command": "modbench.record.copyValue",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == modbench.referencedByTree && listFocus && !inputFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run build:backend",
    "build": "tsc -b && node esbuild.mjs && npm run build:webview",
    "build:webview": "VITE_CJS_IGNORE_WARNING=1 vite build --config webview/vite.config.ts",
    "build:backend": "dotnet publish ../MEditService/MEditService.Http/MEditService.Http.csproj -c Release --self-contained -r linux-x64 -o backend",
    "watch": "node esbuild.mjs --watch",
    "generate-api": "openapi-typescript http://localhost:5172/swagger/v1/swagger.json -o src/wire/generated/api.ts",
    "test:unit": "vitest run",
    "test:mutation": "stryker run",
    "pretest:integration": "node esbuild.mjs",
    "test:integration": "tsc -p tsconfig.integration.json && env -u WAYLAND_DISPLAY -u XDG_SESSION_TYPE xvfb-run -a vscode-test",
    "lint": "eslint src webview/src eslint-rules eslint.config.mjs",
    "prepackage": "cp ../LICENSE ./LICENSE",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "undici": "^7.29.0"
  }
