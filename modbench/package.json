{
  "name": "modbench",
  "displayName": "Modbench",
  "description": "Modbench: install, order, and deploy mods; view, edit, and compare Bethesda plugin files (.esp/.esm/.esl)",
  "version": "0.0.1",
  "publisher": "whiskytangofawks",
  "license": "GPL-3.0-only",
  "icon": "images/medit.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhiskyTangoFawks/ModBench.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Modbench",
      "properties": {
        "modbench.backendPort": {
          "type": "number",
          "default": 5172,
          "description": "Port the mEdit backend API listens on."
        },
        "modbench.game.dataFolderPath": {
          "type": "string",
          "default": "",
          "description": "Override: absolute path to the Fallout 4 Data folder. Leave blank for auto-detect."
        },
        "modbench.game.pluginsTxtPath": {
          "type": "string",
          "default": "",
          "description": "Override: absolute path to Plugins.txt. Leave blank for auto-detect."
        },
        "modbench.scriptsPath": {
          "type": "string",
          "default": "",
          "description": "Path to folder containing .sql filter files and .py scripts. Defaults to ~/.medit/scripts."
        },
        "modbench.mods.gameDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Game directory to deploy into (the folder containing the game executable and Data/). A Steam install or a stock game folder. Leave blank to fall back to ModOrganizer.ini's gamePath, then Steam auto-detect."
        },
        "modbench.mods.deploymentMode": {
          "type": "string",
          "enum": [
            "standalone",
            "external"
          ],
          "enumDescriptions": [
            "Modbench hardlinks the merged mod view into the game directory's Data/ (the mechanism on Linux, where MO2's USVFS is unavailable).",
            "An external manager (MO2/Vortex) owns deployment; Modbench hides Deploy/Purge/Launch Game."
          ],
          "default": "external",
          "scope": "resource",
          "description": "Who deploys mods into the game directory."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modbench",
          "title": "Modbench",
          "icon": "images/medit.svg"
        }
      ],
      "panel": [
        {
          "id": "modbenchReferencedBy",
          "title": "Referenced By",
          "icon": "images/medit.svg"
        }
      ]
    },
    "views": {
      "modbench": [
        {
          "id": "modbench.loadoutHeader",
          "name": "Loadout"
        },
        {
          "id": "modbench.modList",
          "name": "Mods"
        },
        {
          "id": "modbench.pluginListTree",
          "name": "Plugins"
        },
        {
          "id": "modbench.downloads",
          "name": "Downloads",
          "visibility": "collapsed"
        },
        {
          "id": "modbench.changeGroupTree",
          "name": "Plugins - Pending Changes",
          "when": "modbench.hasPendingChanges"
        }
      ],
      "modbenchReferencedBy": [
        {
          "id": "modbench.referencedByTree",
          "name": "Plugins - Referenced By"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "modbench.modList",
        "contents": "This isn't an MO2 instance.\nOpen the folder containing `ModOrganizer.ini`, alongside `mods/` and `profiles/`.\n[Open Folder…](command:vscode.openFolder)",
        "when": "workspaceFolderCount != 0 && !modbench.workspaceIsMo2Instance"
      },
      {
        "view": "modbench.downloads",
        "contents": "This instance has no `downloads/` folder.",
        "when": "!modbench.downloadsFolderExists"
      },
      {
        "view": "modbench.downloads",
        "contents": "No downloads yet. Copy archives into `downloads/` to see them here.",
        "when": "modbench.downloadsFolderExists"
      }
    ],
