{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Every unit test and every test double, compiled against each project's declarations: a
    // test may reach outside its box, so none compiles inside one.
    "noEmit": true,
    "tsBuildInfoFile": "./out/projects/test.tsbuildinfo"
  },
  "references": [
    { "path": "./src" },
    { "path": "./src/loadOrderFileCodec" },
    { "path": "./src/tables" },
    { "path": "./src/wire" },
    { "path": "./src/ports" },
    { "path": "./src/instanceAdapter" },
    { "path": "./src/coreLib" },
    { "path": "./src/instanceLoader" },
    { "path": "./src/modCommands" },
    { "path": "./src/pluginCommands" },
    { "path": "./src/instanceCommands" },
    { "path": "./src/sourceCommands" },
    { "path": "./src/downloadedFileCommands" },
    { "path": "./src/client" },
    { "path": "./src/nexus" },
    { "path": "./src/deployment" },
    { "path": "./src/drivingLib" },
    { "path": "./src/textDocuments" },
    { "path": "./src/toolbox" },
    { "path": "./src/mods" },
    { "path": "./src/downloads" },
    { "path": "./src/plugins" },
    { "path": "./src/editor" },
    { "path": "./src/sourceLanguage" },
    { "path": "./src/agent" }
  ],
  "include": ["src/**/*.test.ts", "src/**/test/**/*.ts"],
  "exclude": ["src/test/integration"]
}
