{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Every unit test and every test double, compiled against each project's declarations: a
    // test may reach outside its box, so none compiles inside one.
    "noEmit": true,
    "tsBuildInfoFile": "./out/projects/test.tsbuildinfo"
  },
  "references": [
    { "path": "./src" },
    { "path": "./src/mo2Codecs" },
    { "path": "./src/tables" },
    { "path": "./src/wire" },
    { "path": "./src/ports" },
    { "path": "./src/instanceAdapter" },
    { "path": "./src/instanceLoader" },
    { "path": "./src/modlist" },
    { "path": "./src/pluginsCommands" },
    { "path": "./src/instanceCommands" },
    { "path": "./src/install" },
    { "path": "./src/client" },
    { "path": "./src/toolbox" },
    { "path": "./src/mods" },
    { "path": "./src/downloads" },
    { "path": "./src/plugins" },
    { "path": "./src/editor" }
  ],
  "include": ["src/**/*.test.ts", "src/**/test/**/*.ts"],
  "exclude": ["src/test/integration"]
}
