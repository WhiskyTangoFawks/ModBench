# Ship only the bundled runtime (out/ + the published backend/ + the medit Python module in scripts/) — not sources.
.vscode/**
.vscode-test/**
.vscode-test.mjs
CLAUDE.md
src/**
webview/**
node_modules/**
**/*.ts
**/*.map
**/tsconfig*.json
**/.eslintrc*
eslint.config.*
esbuild.mjs
buildWebview.mjs
package.mjs
notices.mjs
notice-licenses/**
knip.jsonc
eslint-rules/**
backend/**/*.pdb
backend/**/*.xml
backend/appsettings.Development.json
integration.mjs
vitest.config.*
**/*.test.*
out/**

# Keep: out/ (bundled extension + webview) and backend/ (published self-contained
# service). vsce's negate matching is a blanket OR over the whole file, not
# gitignore-style last-match-wins — a broad `!out/**` would rescue everything
# under out/, including the **/*.map and **/*.test.* exclusions above,
# regardless of line order. Whitelist exactly the runtime output instead of
# re-including the whole tree.
!out/extension.js
!out/fomodEngine.js
!out/fomodEngine/**
!out/webview/**
