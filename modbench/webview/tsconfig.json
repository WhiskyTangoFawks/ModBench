{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // Off: it fights the generated wire types, which already say honestly which fields are optional.
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  // The record panel reads the kernel's wire box, the one arrow it has into src/.
  "references": [{ "path": "../src/wire" }],
  "include": ["src"]
}
