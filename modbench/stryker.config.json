{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "maxTestRunnerReuse": 40,
  "reporters": ["json", "html", "dots"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/test/**",
    "!src/wire/generated/**",
    "!src/mods/ModListProvider.ts",
    "!src/plugins/PluginsTreeProvider.ts",
    "!src/downloads/DownloadsProvider.ts",
    "!src/downloads/DownloadsPanel.ts"
  ]
}
