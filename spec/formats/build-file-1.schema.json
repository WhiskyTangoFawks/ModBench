{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build file",
  "description": "How a build makes a mod's folder from its mod source.",
  "type": "object",
  "properties": {
    "version": {
      "description": "The format's version.",
      "const": 1
    },
    "steps": {
      "description": "The steps the build runs, in order.",
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "required": ["version"],
  "additionalProperties": false,
  "$defs": {
    "paths": {
      "type": "array",
      "items": { "$ref": "manifest-1.schema.json#/$defs/path" },
      "minItems": 1,
      "uniqueItems": true
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decompile": { "description": "Each plugin to decompile into its plugin source, by its path in the mod source.", "$ref": "#/$defs/paths" }
          },
          "required": ["decompile"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "compile": { "description": "Each plugin to compile from its plugin source into the mod's folder, by its path in both.", "$ref": "#/$defs/paths" }
          },
          "required": ["compile"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "copy": { "description": "Each file or folder to copy from the mod source into the mod's folder, by its path in both.", "$ref": "#/$defs/paths" }
          },
          "required": ["copy"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "pack": {
              "description": "Each archive to pack, by its path in the mod's folder, with the paths of the loose files it packs there.",
              "type": "object",
              "propertyNames": { "$ref": "manifest-1.schema.json#/$defs/path" },
              "additionalProperties": { "$ref": "#/$defs/paths" },
              "minProperties": 1
            }
          },
          "required": ["pack"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unpack": {
              "description": "Each archive to unpack, by its path in the mod source, with each file it unpacks into the mod's folder, by its path in the archive and in the mod's folder.",
              "type": "object",
              "propertyNames": { "$ref": "manifest-1.schema.json#/$defs/path" },
              "additionalProperties": { "$ref": "#/$defs/paths" },
              "minProperties": 1
            }
          },
          "required": ["unpack"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "description": "The program the step runs, by its name on the machine's PATH, then its arguments. It runs in the mod's folder, and each `${source}` in an argument is the mod source's folder.",
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          },
          "required": ["command"],
          "additionalProperties": false
        }
      ]
    }
  }
}
