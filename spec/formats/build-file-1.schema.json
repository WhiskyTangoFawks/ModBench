{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build file",
  "description": "How a source mod's build makes the mod's folder from its source folder.",
  "type": "object",
  "properties": {
    "version": {
      "description": "The format's version.",
      "const": 1
    },
    "steps": {
      "description": "The steps the build runs, in order.",
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "required": ["version"],
  "additionalProperties": false,
  "$defs": {
    "paths": {
      "type": "array",
      "items": { "$ref": "manifest-1.schema.json#/$defs/path" },
      "minItems": 1,
      "uniqueItems": true
    },
    "args": {
      "description": "The arguments the step hands what it runs.",
      "type": "array",
      "items": { "type": "string" }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decompile": { "description": "Each plugin to decompile into its plugin source, by its path in the source folder.", "$ref": "#/$defs/paths" }
          },
          "required": ["decompile"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "compile": { "description": "Each plugin to compile from its plugin source into the mod's folder, by its path in both.", "$ref": "#/$defs/paths" }
          },
          "required": ["compile"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "copy": { "description": "Each file or folder to copy from the source folder into the mod's folder, by its path in both.", "$ref": "#/$defs/paths" }
          },
          "required": ["copy"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "pack": {
              "description": "Each archive to pack, by its path in the mod's folder, with the paths of the loose files it packs there.",
              "type": "object",
              "propertyNames": { "$ref": "manifest-1.schema.json#/$defs/path" },
              "additionalProperties": { "$ref": "#/$defs/paths" },
              "minProperties": 1
            }
          },
          "required": ["pack"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unpack": {
              "description": "Each archive to unpack, by its path in the source folder, with each file it unpacks into the mod's folder, by its path in the archive and in the mod's folder.",
              "type": "object",
              "propertyNames": { "$ref": "manifest-1.schema.json#/$defs/path" },
              "additionalProperties": { "$ref": "#/$defs/paths" },
              "minProperties": 1
            }
          },
          "required": ["unpack"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "task": {
              "description": "The label of the VS Code user task that runs the step, in the mod's folder.",
              "type": "string",
              "minLength": 1
            },
            "args": { "$ref": "#/$defs/args" },
            "page": {
              "description": "The page where the user gets the tool the task runs. Absent when the tool comes with the source folder.",
              "type": "string",
              "format": "uri"
            }
          },
          "required": ["task"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "script": {
              "description": "The Modbench script the step runs, by its path in the source folder.",
              "$ref": "manifest-1.schema.json#/$defs/path"
            },
            "args": { "$ref": "#/$defs/args" }
          },
          "required": ["script"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "defaultScript": {
              "description": "The default Modbench script the step runs, by its name.",
              "type": "string",
              "minLength": 1
            },
            "args": { "$ref": "#/$defs/args" }
          },
          "required": ["defaultScript"],
          "additionalProperties": false
        }
      ]
    }
  }
}
