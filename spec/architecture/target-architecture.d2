# The zoom-out. Row = layer, column = process; each mEdit layer sits beside its Modbench
# twin and means the same thing. A module box carries its name, its purpose and, when it has
# one, its secret. A cylinder is a store and carries what it holds. No arrows here: the layer
# rule is layers.d2, a reference is a line in a project file, and every data flow is a trace.
...@styles
grid-rows: 7
grid-columns: 2
grid-gap: 24

medit_drivers: "MEDIT · Drivers — its clients" {
  class: band; grid-rows: 1
  modbench: "Modbench\nthe right column" {class: driving}
  scripts: "Scripts\nowns: xEdit scripting in Python\nhides: the HTTP calls" {class: driving}
}
modbench_drivers: "MODBENCH · Drivers — the user, in VS Code's trees, panels and palette, and the user's agent" {
  class: band; grid-rows: 1
  user: "The user\nclicks, checks, drags, types" {class: other}
  agent_driver: "The agent\nasks and acts through MCP" {class: other}
  activation: "Activation\nowns: wiring" {class: driving}
}

medit_driving: "MEDIT · Driving adapters — the API" {
  class: band; grid-rows: 1
  http: "HTTP endpoints\nowns: mEdit's API, and its composition root\nhides: the protocol" {class: driving}
}
modbench_driving: "MODBENCH · Driving adapters — the views and the agent: read a value, fire a command" {
  class: band; grid-rows: 1
  toolbox: "Toolbox\nowns: the instance at a glance" {class: driving}
  mods: "Mods\nowns: the mods and their conflicts, as the user sees them" {class: driving}
  plugins: "Plugins\nowns: the Plugins tree, as the user sees it\nhides: how mEdit's answers meet the instance" {class: driving}
  downloads: "Downloads\nowns: the downloaded files, as the user sees them" {class: driving}
  editor: "Editor\nowns: a record, opened to read and edit" {class: driving}
  webview: "Webview pages\nowns: the pages a view draws in a webview\nhides: the grid" {class: driving}
  sourcelanguage: "Source language\nowns: VS Code's language features over plugin source\nhides: the map from a text position to a FormKey" {class: driving}
  agent: "Agent\nowns: what the user's agent reads and runs,\nand how a script finds mEdit\nhides: MCP and the terminal's environment" {class: driving}
}

medit_core: "MEDIT · Core — the write side; it references the kernel and the repositories" {
  class: band; grid-rows: 1
  commands: "Commands\nowns: the write side\nhides: the rules that decide a write" {
    engine: "Build engine — one deep module\nowns: a source mod's plugins and archives, from its source\nhides: compiling and packing" {class: core}
  }
}
modbench_core: "MODBENCH · Core — one command per gesture; each writes through a repository and forgets" {
  class: band; grid-rows: 1
  modcommands: "mod commands\nowns: changes to mods and separators, their files,\nand the mod order" {class: core}
  sourcecommands: "source commands\nowns: changes to source mods and the modlist repository" {class: core}
  plugincommands: "plugin commands\nowns: changes to plugins and the plugin order\nhides: how a move is held to the sorting rules" {class: core}
  instancecommands: "instance commands\nowns: changes to the instance as a whole, its profiles\nand its deployment" {class: core}
  downloadedfilecommands: "downloaded file commands\nowns: changes to the downloaded files" {class: core}
}

medit_kernel: "MEDIT · Kernel — read by the core, the read model and the repositories; a port lives here; Ports reads Load order state; nothing else in the kernel references anything" {
  class: band; grid-rows: 1
  loadorder: "Load order state\nowns: the load order Mod Management hands Editing,\nand the strings language" {class: kernel}
  codec: "Codec + schema\nowns: a record as text and as document\nhides: how a document is spelled as text, and each game's types" {class: kernel}
  ports: "Ports\nowns: how mEdit tells its clients what changed" {class: kernel}
}
modbench_kernel: "MODBENCH · Kernel — pure; read by the core, the read model and the repositories; a kernel box references nothing" {
  class: band; grid-rows: 1
  loadorderfilecodec: "Load-order file codec\nowns: plugins.txt as text\nhides: its format" {class: kernel}
  wire: "Wire\nowns: the API types, the webview protocol,\nand the shape of a source mod both processes read" {class: kernel}
  tables: "per-release tables\nowns: what differs per game release\nhides: every game name" {class: kernel}
  sortingrules: "Sorting rules\nowns: whether a plugin order keeps its sorting rules\nhides: each rule, and LOOT's metadata format and condition language" {class: kernel}
  ports: "Ports\nowns: how the core reaches the user and VS Code,\nand the idioms every band shares" {class: kernel}
}

medit_readmodel: "MEDIT · Read model — the record index, a view over the repositories below it" {
  class: band; grid-rows: 1
  recordindex: "Record index — one deep module, rebuildable\nowns: the read model over every plugin\nhides: how records are stored and kept current" {
    indexer: "Indexer\nowns: every plugin's rows, kept current; it decides nothing\nhides: how records are kept current" {class: readmodel}
    store: "Store\nowns: every plugin's rows\nhides: DuckDB" {class: derived}
  }
}
modbench_readmodel: "MODBENCH · Read model — the instance value, derived from the Instance adapter by watching, and the mod statuses derived from it, and nothing else" {
  class: band; grid-rows: 1
  instanceloader: "Instance loader\nowns: the instance value, recomputed whole on every change" {class: readmodel}
  modstatus: "Mod status\nowns: each mod's status against its manifest,\nderived whole from each instance value" {class: readmodel}
}

medit_repositories: "MEDIT · Repositories — the only boxes that read or write a system of record" {
  class: band; grid-rows: 1
  sourceadapter: "Source adapter\nowns: a source mod's folder: plugin source, assets\nand repository\nhides: the layout inside plugin source, and git" {class: repositories}
  pluginadapter: "Plugin adapter\nowns: the plugin files\nhides: the binary format" {class: repositories}
  modfolderadapter: "Mod folder adapter\nowns: the assets and archives of a source mod's output folder\nhides: the archive formats" {class: repositories}
}
modbench_repositories: "MODBENCH · Repositories — the Instance adapter is the one reader and writer of the mod manager's and the publisher's files" {
  class: band; grid-rows: 1
  instanceadapter: "Instance adapter\nowns: the instance\nhides: the mod manager and the publisher" {
    mo2: "MO2 — one implementation\nowns: the mod manager's files\nhides: MO2's layout and formats" {class: repositories}
    wabbajack: "Wabbajack — one implementation\nowns: the publisher's configuration\nhides: Wabbajack's layout and formats" {class: repositories}
    gamefolder: "Game folder\nowns: where the game is and what it holds\nhides: Steam, Wine and the platform's Documents folder" {class: repositories}
    filecontents: "File contents\nowns: what each downloaded file holds, entry by entry,\nand the hash of every file the Instance adapter reads\nhides: the extraction tool and the hash index" {class: repositories}
    fomodinstaller: "FOMOD installer\nowns: the files a FOMOD installs for my choices\nhides: the engine" {class: repositories}
  }
  manifestadapter: "Manifest adapter\nowns: the manifests and build files\nhides: their text" {class: repositories}
  textdocuments: "Text documents\nowns: plugin source as VS Code holds it, saved and unsaved\nhides: open and unopened documents, and applying\none workspace edit at a time" {class: repositories}
  client: "mEdit client\nowns: Modbench's one reach to mEdit\nhides: mEdit's process and transport,\nand that it forgets on restart" {class: repositories}
  nexus: "Nexus\nowns: Modbench's one reach to Nexus\nhides: the API" {class: repositories}
  lootmetadata: "LOOT metadata\nowns: Modbench's one reach to LOOT's metadata\nhides: its addresses and branches" {class: repositories}
  deployment: "Deployment\nowns: a load order deployed where the game reads it\nhides: the deployment type, and where each platform's game\nreads plugins.txt" {class: repositories}
}

medit_data: "MEDIT · Systems of record" {
  class: band; grid-rows: 1
  source: "Mod source\nthe source folder beside mods/, in git" {class: sor}
  plugin: "Plugin files" {class: sor}
  modfolder: "Mod folders\nthe assets a build is handed, read · the archives it packs" {class: sor}
  tools: "Other tools\nthe mod manager, xEdit, CK, the game — at any time" {class: other}
}
modbench_data: "MODBENCH · Systems of record; mEdit is the left column and always running" {
  class: band; grid-rows: 1
  instance: "Instance\nthe mod manager's files · each profile's plugins.txt ·\nmods · Overwrite · downloaded files and their index ·\nthe hash index · the manifests · the repository ·\nthe source folder · the publisher's configuration ·\nthe sorting rule files" {class: sor}
  gamedata: "Game folder\nthe game's own plugins and files" {class: sor}
  deployed: "Deployment\nthe deployment folder · the plugins.txt the game reads ·\nwhat other programs write there" {class: sor}
  tools: "Other tools\nthe mod manager, the user, the game — at any time" {class: other}
  medit: "mEdit\nthe left column" {class: driving}
  nexus: "Nexus\nthe mods and files it hosts" {class: other}
  loot: "LOOT\nthe masterlists and the prelude it hosts" {class: other}
}
