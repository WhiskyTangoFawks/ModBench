#!/usr/bin/env bash
# A commit on main gets no /validate run, and a spec/ or docs/ change can break the scans that read them.
[[ $(git symbolic-ref -q --short HEAD) == main ]] || exit 0
git diff --cached --name-only | grep -qE '^(spec|docs)/' || exit 0
gates="$(git rev-parse --show-toplevel)/.claude/skills/validate/run-gates.sh"
# Git hands a hook the commit's own index, which the gates' git calls in other repositories would write to.
unset $(git rev-parse --local-env-vars)
exec bash "$gates" --docs
